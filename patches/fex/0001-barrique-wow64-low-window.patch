--- a/Source/Windows/WOW64/Module.cpp
+++ b/Source/Windows/WOW64/Module.cpp
@@ -169,6 +169,22 @@ uint64_t GetWowTEB(void* TEB) {
     *reinterpret_cast<LONG*>(reinterpret_cast<uintptr_t>(TEB) + WowTEBOffsetMemberOffset) + reinterpret_cast<uint64_t>(TEB));
 }
 
+// A host that cannot map the low 4GB (macOS on arm64 under Wine's Hypervisor.framework
+// backend) puts the 32-bit address space in a 4GB-aligned window higher up, with the
+// 32-bit TEB inside it, and the guest also sees it at its 32-bit address. The 64-bit
+// side then hands out window addresses; the emulated code must use 32-bit ones.
+uint64_t ToGuestAddress(uint64_t Address) {
+  const uint64_t Base = GetWowTEB(NtCurrentTeb()) & ~0xffffffffULL;
+  return Address - Base < 0x100000000ULL ? Address - Base : Address;
+}
+
+// The other way round, for 32-bit pointers handed to the 64-bit side, which may pass
+// them on to the host. Values below 64K and from 0xfffe0000 up are not real addresses.
+void* ToHostAddress(uint32_t Address) {
+  const uint64_t Base = GetWowTEB(NtCurrentTeb()) & ~0xffffffffULL;
+  return reinterpret_cast<void*>(Address >= 0x10000 && Address < 0xfffe0000 ? Base + Address : Address);
+}
