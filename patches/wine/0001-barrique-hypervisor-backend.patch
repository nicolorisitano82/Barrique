@@ -2726,6 +2726,14 @@ static FORCEINLINE struct _TEB * WINAPI NtCurrentTeb(void)
 {
     return (struct _TEB *)__readfsdword( 0x18 );
 }
+#elif defined(__aarch64__) && defined(__APPLE__) && defined(WINE_UNIX_LIB)
+/* macOS reserves x18 and the kernel clobbers it: Windows code runs in a
+ * Hypervisor.framework VM, the host side keeps the TEB in thread-local storage. */
+extern struct _TEB *__wine_unix_current_teb(void);
+static FORCEINLINE struct _TEB * WINAPI NtCurrentTeb(void)
+{
+    return __wine_unix_current_teb();
+}
 #elif (defined(__aarch64__) || defined(__arm64ec__)) && defined(__GNUC__)
 register struct _TEB *__wine_current_teb __asm__("x18");
 static FORCEINLINE struct _TEB * WINAPI NtCurrentTeb(void)
