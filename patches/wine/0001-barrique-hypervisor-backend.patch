+ *           fork_child
+ *
+ * fork() and run child( arg ) in the child, which must not return.
+ * Returns the child pid in the parent, -1 with errno set on failure.
+ */
+#ifdef WINE_HVF
+/* When running in a VM, Windows memory is not inherited by fork() children
+ * (see hvf.c), and that includes the stacks of Windows threads: a child forked
+ * there crashes on its first stack access. Fork from a host thread instead,
+ * with the arguments copied to the host heap. */
+struct host_fork
+{
+    void (*child)( void *arg );
+    void  *arg;
+    pid_t  pid;
+    int    err;
+};
+
+static void *host_fork_thread( void *ptr )
+{
+    struct host_fork *hf = ptr;
+
+    if (!(hf->pid = fork())) hf->child( hf->arg );
+    hf->err = errno;
+    return NULL;
+}
+
+static pid_t fork_child( void (*child)( void *arg ), const void *arg, size_t size )
+{
+    struct host_fork *hf;
+    pthread_t thread;
+    pid_t pid;
+    int err;
+
+    if (!(hf = malloc( sizeof(*hf) + size )))
+    {
+        errno = ENOMEM;
+        return -1;
+    }
+    hf->child = child;
+    hf->arg = memcpy( hf + 1, arg, size );
+    if ((err = pthread_create( &thread, NULL, host_fork_thread, hf )))
+    {
+        free( hf );
+        errno = err;
+        return -1;
+    }
+    pthread_join( thread, NULL );
+    pid = hf->pid;
+    err = hf->err;
+    free( hf );
+    if (pid == -1) errno = err;
+    return pid;
+}
+#else
+static pid_t fork_child( void (*child)( void *arg ), const void *arg, size_t size )
+{
+    pid_t pid = fork();
+
+    if (!pid) child( (void *)arg );
+    return pid;
+}
+#endif
