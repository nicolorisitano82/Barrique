+#if defined(__APPLE__) && defined(__aarch64__)
+/*
+ * On Apple Silicon Windows code runs in a Hypervisor.framework VM, which can
+ * only be given anonymous memory: file-backed pages can panic the kernel when
+ * mapped into the VM. Anonymous mappings (pagefile-backed sections) are
+ * therefore POSIX shared memory objects. They can't be read/written with
+ * pread/pwrite and their size can only be set once, so they are created with
+ * their final size and "growing" only succeeds within that size.
+ */
+#define USE_SHM_SECTIONS 1
+
+static int is_shm_fd( int unix_fd, off_t *size )
+{
+    struct stat st;
+
+    if (fstat( unix_fd, &st ) || (st.st_mode & S_IFMT)) return 0;  /* shm objects have no file type */
+    if (size) *size = st.st_size;
+    return 1;
+}
+
+static int create_shm_file( file_pos_t size )
+{
+    static unsigned int counter;
+    char name[32];
+    int fd;
+
+    snprintf( name, sizeof(name), "/wine-%x-%x", (int)getpid(), counter++ );
+    if ((fd = shm_open( name, O_RDWR | O_CREAT | O_EXCL, 0600 )) == -1)
+    {
+        file_set_error();
+        return -1;
+    }
+    shm_unlink( name );
+    if (ftruncate( fd, size ) == -1)
+    {
+        file_set_error();
+        close( fd );
+        return -1;
+    }
+    return fd;
+}
+#endif
