+    uint32_t strides[D3D12_IA_VERTEX_INPUT_RESOURCE_SLOT_COUNT] = {0};
+    struct d3d12_device *device = state->device;
+    D3D12_PRIMITIVE_TOPOLOGY topology = 0;
+    const struct vkd3d_pso_hint *hint;
+    VkRenderPass vk_render_pass;
