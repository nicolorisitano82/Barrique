+    if (table == get_teb_data( data )->syscall_table && is_wait_syscall( func )) hvf_release_vcpu();
+    return func( args[0], args[1], args[2], args[3], args[4], args[5], args[6], args[7], args[8], args[9],
+                 args[10], args[11], args[12], args[13], args[14], args[15], args[16], args[17], args[18], args[19] );
+}
+
+/* turn a guest exception into a Windows exception on the guest stack */
+static void hvf_handle_exception( struct thread_data *data, const struct hvf_exit *ex, struct hvf_regs *regs )
+{
+    EXCEPTION_RECORD rec = { .ExceptionAddress = (void *)regs->pc };
+    struct exc_stack_layout *stack;
+    CONTEXT context = { .ContextFlags = CONTEXT_FULL };
+    NTSTATUS status;
+    unsigned int i;
+
+    if (ex->vector != 8)
+    {
+        ERR( "exception in guest EL1: vector %u esr %llx far %llx elr %llx\n", ex->vector,
+             (unsigned long long)ex->esr, (unsigned long long)ex->far, (unsigned long long)regs->pc );
+        abort_process( 1 );
+    }
+
+    for (i = 0; i < 29; i++) context.X[i] = regs->x[i];
+    context.Fp   = regs->x[29];
+    context.Lr   = regs->x[30];
+    context.Sp   = regs->sp;
+    context.Pc   = regs->pc;
+    context.Cpsr = regs->cpsr;
+    context.Fpcr = regs->fpcr;
+    context.Fpsr = regs->fpsr;
+    memcpy( context.V, regs->v, sizeof(context.V) );
+
+    switch (ESR_ELx_EC( ex->esr ))
+    {
+    case ESR_ELx_EC_IABT_LOW:
+    case ESR_ELx_EC_PC_ALIGN:
+        rec.ExceptionCode = EXCEPTION_ACCESS_VIOLATION;
+        rec.ExceptionInformation[0] = EXCEPTION_EXECUTE_FAULT;
+        rec.ExceptionInformation[1] = ex->far;
+        rec.NumberParameters = 2;
+        break;
+    case ESR_ELx_EC_DABT_LOW:
+        if (ESR_ELx_ISS_DFSC( ex->esr ) == ESR_ELx_ISS_DFSC_ALIGN_FAULT)
+        {
+            rec.ExceptionCode = EXCEPTION_DATATYPE_MISALIGNMENT;
+            break;
+        }
+        rec.ExceptionCode = EXCEPTION_ACCESS_VIOLATION;
+        rec.ExceptionInformation[0] = ESR_ELx_ISS_DABT_WNR( ex->esr ) ? EXCEPTION_WRITE_FAULT : EXCEPTION_READ_FAULT;
+        rec.ExceptionInformation[1] = ex->far;
+        rec.NumberParameters = 2;
+        /* guard pages, write watches: the fix changes the protection and we just retry;
+         * the host knows memory below 4GB by its low window address, see hvf_low_ptr() */
+        rec.ExceptionInformation[1] = (ULONG_PTR)hvf_low_ptr( ex->far );
+        if (!virtual_handle_fault( data, &rec, (void *)regs->sp )) return;
+        rec.ExceptionInformation[1] = ex->far;
+        break;
+    case ESR_ELx_EC_BRK64:
+        switch (ESR_ELx_ISS_BRK_COMMENT( ex->esr ))
+        {
+        case 0xf000:
+            context.Pc += 4;  /* skip the brk instruction */
+            rec.ExceptionCode = EXCEPTION_BREAKPOINT;
+            rec.NumberParameters = 1;
+            break;
+        case 0xf001:
+            rec.ExceptionCode = STATUS_ASSERTION_FAILURE;
+            break;
+        case 0xf003:
+            rec.ExceptionCode = STATUS_STACK_BUFFER_OVERRUN;
+            rec.ExceptionFlags = EXCEPTION_NONCONTINUABLE;
+            rec.NumberParameters = 1;
+            rec.ExceptionInformation[0] = context.X[0];
+            break;
+        case 0xf004:
+            rec.ExceptionCode = EXCEPTION_INT_DIVIDE_BY_ZERO;
+            break;
+        default:
+            /* as trap_handler: other comments are illegal instructions; the x86
+             * emulators rely on it, e.g. FEX's suspend trap brk #0xcafe */
+            rec.ExceptionCode = EXCEPTION_ILLEGAL_INSTRUCTION;
+            break;
+        }
+        break;
+    case ESR_ELx_EC_SOFTSTP_LOW:
+        rec.ExceptionCode = EXCEPTION_SINGLE_STEP;
+        break;
+    default:
+        rec.ExceptionCode = EXCEPTION_ILLEGAL_INSTRUCTION;
+        break;
+    }
+
+    TRACE( "code %#x at %p addr %#llx\n", rec.ExceptionCode, rec.ExceptionAddress, (unsigned long long)ex->far );
+    /* inside the x64 emulator the debugger gets the event from the emulated context instead */
+    if (data->teb->ChpeV2CpuAreaInfo && data->teb->ChpeV2CpuAreaInfo->InSimulation)
+        status = DBG_EXCEPTION_NOT_HANDLED;
+    else
+        status = send_debug_event( data, &rec, &context, TRUE );
+    if ((status == DBG_CONTINUE || status == DBG_EXCEPTION_HANDLED) && is_emulated_code( context.Pc ))
+    {
+        /* the debugger moved the thread into x64 code */
+        CONTEXT *user_context = (CONTEXT *)((context.Sp - sizeof(CONTEXT)) & ~15);
+
+        data->teb->ChpeV2CpuAreaInfo->InSimulation = 1;
+        *user_context = context;
+        user_context->ContextFlags = CONTEXT_FULL;
+        regs->sp = (ULONG64)user_context;
+        regs->pc = (ULONG64)pKiUserEmulationDispatcher;
+        hvf_set_user_regs( regs, FALSE );
+        return;
+    }
+    if (status == DBG_CONTINUE || status == DBG_EXCEPTION_HANDLED)
+    {
+        for (i = 0; i < 29; i++) regs->x[i] = context.X[i];
+        regs->x[29] = context.Fp;
+        regs->x[30] = context.Lr;
+        regs->sp = context.Sp;
+        regs->pc = context.Pc;
+        hvf_set_user_regs( regs, FALSE );
+        return;
+    }
+
+    stack = virtual_setup_exception( data, (void *)(regs->sp & ~15), sizeof(*stack), &rec );
+    stack->rec = rec;
+    stack->context = context;
+    context_init_empty_xstate( &stack->context, stack->redzone );
+    regs->sp = (ULONG64)stack;
+    regs->pc = (ULONG64)pKiUserExceptionDispatcher;
+    regs->x[18] = (ULONG64)data->teb;
+    hvf_set_user_regs( regs, FALSE );
+}
+
+/* handle a signal deferred by hvf_defer_signal(); the frame holds the guest state.
+ * user: the guest was stopped in user code, not on a syscall entry */
+static void hvf_handle_pending( BOOL user )
+{
+    LONG what = __atomic_exchange_n( &hvf_pending, 0, __ATOMIC_SEQ_CST );
+    sigset_t old_set;
+    CONTEXT context;
+
+    if (!what) return;
+    if (what & HVF_PENDING_QUIT) abort_thread( 0 );
+
+    pthread_sigmask( SIG_BLOCK, &server_block_set, &old_set );
+    context.ContextFlags = CONTEXT_FULL | CONTEXT_ARM64_X18 | (user ? 0 : CONTEXT_EXCEPTION_REQUEST);
+    NtGetContextThread( GetCurrentThread(), &context );
+    if (user) context.ContextFlags |= CONTEXT_EXCEPTION_REPORTING;
+    wait_suspend( &context );
+    NtSetContextThread( GetCurrentThread(), &context );
+    pthread_sigmask( SIG_SETMASK, &old_set, NULL );
+}
+
+/* run guest code until the thread exits, or until cb is completed by NtCallbackReturn */
+static void hvf_loop( struct hvf_callback *cb )
+{
+    struct hvf_exit ex;
+    struct hvf_regs regs;
+
+    for (;;)
+    {
+        struct thread_data *data;
+        struct syscall_frame * volatile frame;  /* used after longjmp */
+        ULONG64 ret;
+
+        hvf_in_guest = TRUE;
+        hvf_run( &ex, &hvf_pending );
+        data = get_thread_data();
+        frame = get_syscall_frame( data );
+        hvf_get_user_regs( &regs, TRUE );
+
+        switch (ex.type)
+        {
+        case HVF_EXIT_SYSCALL:
+        case HVF_EXIT_UNIX_CALL:
+        {
+            jmp_buf jmp, *prev = hvf_syscall_jmp;
+            int fault;
+
+            if (ex.type == HVF_EXIT_SYSCALL)  /* thunk: mov x8, id; mov x9, x30; ldr x16, dispatcher; blr x16; ret */
+                hvf_save_frame( frame, &regs, regs.x[9], regs.x[30] );
+            else
+                hvf_save_frame( frame, &regs, regs.x[30], regs.x[30] );
+            hvf_in_guest = FALSE;
+            /* a signal that came in after the vCPU stopped: the frame is valid now */
+            if (hvf_pending) hvf_handle_pending( FALSE );
+
+            /* a fault in the host code returns here, see handle_syscall_fault() */
+            if (!(fault = setjmp( jmp )))
+            {
+                hvf_syscall_jmp = &jmp;
+                if (ex.type == HVF_EXIT_SYSCALL) ret = hvf_dispatch_syscall( data, &regs );
+                else ret = ((unixlib_entry_t *)regs.x[0])[regs.x[1]]( (void *)regs.x[2] );
+            }
+            else
+            {
+                ret = (ULONG)fault;
+                /* we may have been inside a user callback: back to this syscall's frame */
+                get_teb_data( data )->syscall_frame = frame;
+                data->jmp_buf = NULL;  /* a Unix-side __TRY we unwound through */
+            }
+            hvf_syscall_jmp = prev;
+            break;
+        }
+        case HVF_EXIT_INTERRUPT:
+        {
+            static LONG count;
+            LONG n = InterlockedIncrement( &count );
+            if (n <= 3 || !(n % 500)) WARN( "guest interrupted for a signal (%d), pc %p\n", n, (void *)regs.pc );
+        }
+            hvf_save_frame( frame, &regs, regs.x[30], regs.pc );
+            hvf_in_guest = FALSE;
+            hvf_handle_pending( TRUE );
+            hvf_restore_frame( frame, frame->x[0] );
+            continue;
+        default:
+            hvf_handle_exception( data, &ex, &regs );
+            continue;
+        }
+        if (cb && cb->done) return;
+        hvf_restore_frame( frame, ret );
+    }
+}
+
+/***********************************************************************
+ *           KeUserModeCallback
+ */
+NTSTATUS KeUserModeCallback( ULONG id, const void *args, ULONG len, void **ret_ptr, ULONG *ret_len )
+{
+    struct thread_data *data = get_thread_data();
+    struct syscall_frame *frame = get_syscall_frame( data );
+    ULONG64 sp = (frame->sp - offsetof( struct callback_stack_layout, args_data[len] ) - 16) & ~15;
+    struct callback_stack_layout *stack = (struct callback_stack_layout *)sp;
+    struct hvf_callback cb __attribute__((aligned(16)));
+    struct hvf_regs regs;
+
+    stack->args = stack->args_data;
+    stack->len  = len;
+    stack->id   = id;
+    stack->lr   = frame->lr;
+    stack->sp   = frame->sp;
+    stack->pc   = frame->pc;
+    memcpy( stack->args_data, args, len );
+
+    memset( &cb, 0, sizeof(cb) );
+    cb.frame.prev_frame = frame;
+    get_teb_data( data )->syscall_frame = &cb.frame;
+
+    memcpy( regs.x, frame->x, sizeof(frame->x) );
+    regs.x[18] = (ULONG64)data->teb;
+    regs.x[29] = frame->fp;
+    regs.x[30] = frame->lr;
+    regs.sp    = sp;
+    regs.pc    = (ULONG64)pKiUserCallbackDispatcher;
+    regs.cpsr  = frame->cpsr;
+    hvf_set_user_regs( &regs, FALSE );
+
+    hvf_loop( &cb );
+
+    get_teb_data( data )->syscall_frame = frame;
+    *ret_ptr = cb.ret_ptr;
+    *ret_len = cb.ret_len;
+    return cb.status;
+}
+
+/***********************************************************************
+ *           NtCallbackReturn  (NTDLL.@)
+ */
+NTSTATUS WINAPI NtCallbackReturn( void *ret_ptr, ULONG ret_len, NTSTATUS status )
+{
+    struct thread_data *data = get_thread_data();
+    struct syscall_frame *frame = get_syscall_frame( data );
+    struct hvf_callback *cb = CONTAINING_RECORD( frame, struct hvf_callback, frame );
+
+    if (!frame->prev_frame) return STATUS_NO_CALLBACK_ACTIVE;
+    cb->ret_ptr = ret_ptr;
+    cb->ret_len = ret_len;
+    cb->status  = status;
+    cb->done    = TRUE;
+    return STATUS_SUCCESS;
+}
+
+/***********************************************************************
+ *           signal_start_thread
+ */
+void DECLSPEC_NORETURN signal_start_thread( PRTL_THREAD_START_ROUTINE entry, void *arg, TEB *teb )
+{
+    struct thread_data *data = get_thread_data();
+    struct syscall_frame storage __attribute__((aligned(16))), *frame;
+
+    if (!(frame = get_syscall_frame( data )))
+    {
+        frame = &storage;
+        get_teb_data( data )->syscall_frame = frame;
+    }
+    frame->restore_flags = 0;
+    frame->prev_frame = NULL;
+    frame->syscall_cfa = NULL;
+    init_syscall_frame( (LPTHREAD_START_ROUTINE)entry, arg, teb );
+    hvf_restore_frame( frame, frame->x[0] );
+    hvf_loop( NULL );
+    abort();
+}
+
+#endif  /* WINE_HVF */
+
 #endif  /* __aarch64__ */
