+            static LONG once;
+            if (!InterlockedExchange(&once, 1)) FIXME("Unhandled composition format %#x.\n", desc.Format);
+            ID3D11Texture2D_Release(buffer);
+            return;
+        }
+    }
+    ID3D11Texture2D_GetDevice(buffer, &device);
+    if (staging)
+    {
+        ID3D11Texture2D_GetDesc(staging, &staging_desc);
+        if (staging_desc.Width != desc.Width || staging_desc.Height != desc.Height || staging_desc.Format != desc.Format)
+        {
+            ID3D11Texture2D_Release(staging);
+            staging = swapchain->composition_staging = NULL;
+        }
+    }
+    if (!staging)
+    {
+        staging_desc = desc;
+        staging_desc.MipLevels = staging_desc.ArraySize = 1;
+        staging_desc.SampleDesc.Count = 1;
+        staging_desc.SampleDesc.Quality = 0;
+        staging_desc.Usage = D3D11_USAGE_STAGING;
+        staging_desc.BindFlags = 0;
+        staging_desc.CPUAccessFlags = D3D11_CPU_ACCESS_READ;
+        staging_desc.MiscFlags = 0;
+        if (FAILED(ID3D11Device_CreateTexture2D(device, &staging_desc, NULL, &staging)))
+        {
+            ID3D11Device_Release(device);
+            ID3D11Texture2D_Release(buffer);
+            return;
+        }
+        swapchain->composition_staging = staging;
+    }
+
+    ID3D11Device_GetImmediateContext(device, &context);
