+/* Barrique: vkCmd* calls without results are recorded here and sent to the Unix
+ * side in one call when the command buffer ends (or another call on it needs the
+ * recorded state): every Unix call is a VM exit under HVF, and D3D12 games record
+ * 100k+ commands per second. Commands on a buffer are externally synchronized,
+ * so the batch needs no lock. BARRIQUE_VK_BATCH=0 turns it off. */
+#define VK_BATCH_SIZE 0x10000
+
+struct vk_command_batch
+{
+    UINT32 used;
+    UINT32 pad;
+    BYTE data[VK_BATCH_SIZE];
+};
+
+#ifdef _WIN64
+static int batch_enabled = -1;
+#endif
+
+void *wine_vk_batch_begin(VkCommandBuffer buffer, UINT32 code, size_t size)
+{
+#ifdef _WIN64
+    struct vk_command_batch *batch;
+    size_t total = 8 + size;
+    BYTE *record;
+
+    if (batch_enabled < 0)
+    {
+        char value[8];
+        batch_enabled = !GetEnvironmentVariableA("BARRIQUE_VK_BATCH", value, sizeof(value)) || value[0] != '0';
+    }
+    if (!batch_enabled || !buffer || total > VK_BATCH_SIZE / 4) return NULL;
+    if (!(batch = buffer->batch))
+    {
+        if (!(batch = malloc(sizeof(*batch)))) return NULL;
+        batch->used = 0;
+        buffer->batch = batch;
+    }
+    if (batch->used + total > VK_BATCH_SIZE) wine_vk_flush_batch(buffer);
+    record = batch->data + batch->used;
+    ((UINT32 *)record)[0] = code;
+    ((UINT32 *)record)[1] = total;
+    batch->used += total;
+    return record + 8;
+#else
+    return NULL;
+#endif
+}
+
+void wine_vk_flush_batch(VkCommandBuffer buffer)
+{
+    struct flush_command_batch_params params;
+
+    if (!buffer || !buffer->batch || !buffer->batch->used) return;
+    params.data = buffer->batch->data;
+    params.size = buffer->batch->used;
+    buffer->batch->used = 0;
+    UNIX_CALL(flush_command_batch, &params);
+}
+
+void wine_vk_discard_batch(VkCommandBuffer buffer)
+{
+    if (buffer && buffer->batch) buffer->batch->used = 0;
+}
+
+/* structs starting with sType and pNext, batched only without extension chains */
+BOOL wine_vk_no_pnext(const void *structs, uint32_t count, size_t size)
+{
+    const BYTE *ptr = structs;
+    uint32_t i;
+
+    for (i = 0; i < count; i++)
+        if (((const VkBaseInStructure *)(ptr + i * size))->pNext) return FALSE;
+    return TRUE;
+}
+
+/* Barrique: vkCmdBeginRenderPass into the command batch, with the begin info and
+ * its clear values copied; vkd3d begins a render pass for nearly every draw state
+ * change. Returns FALSE if the call can't be batched. */
+BOOL wine_vk_batch_begin_render_pass(VkCommandBuffer buffer, UINT32 code, const void *params,
+        size_t params_size, size_t begin_offset, const VkRenderPassBeginInfo *begin)
+{
+    size_t clear_size = begin->clearValueCount * sizeof(*begin->pClearValues);
+    VkRenderPassBeginInfo *copy;
+    BYTE *batch;
+
+    if (begin->pNext) return FALSE;
+    if (!(batch = wine_vk_batch_begin(buffer, code, VK_BATCH_ALIGN(params_size)
+            + VK_BATCH_ALIGN(sizeof(*begin)) + VK_BATCH_ALIGN(clear_size))))
+        return FALSE;
+
+    memcpy(batch, params, params_size);
+    copy = (VkRenderPassBeginInfo *)(batch + VK_BATCH_ALIGN(params_size));
+    *copy = *begin;
+    *(VkRenderPassBeginInfo **)(batch + begin_offset) = copy;
+    if (begin->pClearValues)
+    {
+        copy->pClearValues = (void *)((BYTE *)copy + VK_BATCH_ALIGN(sizeof(*begin)));
+        memcpy((void *)copy->pClearValues, begin->pClearValues, clear_size);
+    }
+    return TRUE;
+}
+
+/* descriptor info array a VkWriteDescriptorSet uses, and its element size */
+static const void *write_descriptor_infos(const VkWriteDescriptorSet *write, size_t *size)
+{
+    switch (write->descriptorType)
+    {
+        case VK_DESCRIPTOR_TYPE_SAMPLER:
+        case VK_DESCRIPTOR_TYPE_COMBINED_IMAGE_SAMPLER:
+        case VK_DESCRIPTOR_TYPE_SAMPLED_IMAGE:
+        case VK_DESCRIPTOR_TYPE_STORAGE_IMAGE:
+        case VK_DESCRIPTOR_TYPE_INPUT_ATTACHMENT:
+            *size = sizeof(*write->pImageInfo);
+            return write->pImageInfo;
+        case VK_DESCRIPTOR_TYPE_UNIFORM_TEXEL_BUFFER:
+        case VK_DESCRIPTOR_TYPE_STORAGE_TEXEL_BUFFER:
+            *size = sizeof(*write->pTexelBufferView);
+            return write->pTexelBufferView;
+        case VK_DESCRIPTOR_TYPE_UNIFORM_BUFFER:
+        case VK_DESCRIPTOR_TYPE_STORAGE_BUFFER:
+        case VK_DESCRIPTOR_TYPE_UNIFORM_BUFFER_DYNAMIC:
+        case VK_DESCRIPTOR_TYPE_STORAGE_BUFFER_DYNAMIC:
+            *size = sizeof(*write->pBufferInfo);
+            return write->pBufferInfo;
+        default:
+            return NULL;
+    }
+}
+
+/* Barrique: vkCmdPushDescriptorSet(KHR) into the command batch, with the writes and
+ * the descriptor infos they point to copied; vkd3d pushes root descriptors with it
+ * for nearly every draw. Returns FALSE if the call can't be batched. */
+BOOL wine_vk_batch_push_descriptor_set(VkCommandBuffer buffer, UINT32 code, const void *params,
+        size_t params_size, size_t writes_offset, uint32_t write_count, const VkWriteDescriptorSet *writes)
+{
+    size_t size = VK_BATCH_ALIGN(params_size) + VK_BATCH_ALIGN(write_count * sizeof(*writes)), info_size;
+    VkWriteDescriptorSet *copy;
+    BYTE *batch, *extra;
+    const void *infos;
+    uint32_t i;
+
+    for (i = 0; i < write_count; i++)
+    {
+        if (writes[i].pNext || !(infos = write_descriptor_infos(&writes[i], &info_size))) return FALSE;
+        size += VK_BATCH_ALIGN(writes[i].descriptorCount * info_size);
+    }
+    if (!(batch = wine_vk_batch_begin(buffer, code, size))) return FALSE;
+
+    memcpy(batch, params, params_size);
+    copy = (VkWriteDescriptorSet *)(batch + VK_BATCH_ALIGN(params_size));
+    memcpy(copy, writes, write_count * sizeof(*writes));
+    *(VkWriteDescriptorSet **)(batch + writes_offset) = copy;
+    extra = (BYTE *)copy + VK_BATCH_ALIGN(write_count * sizeof(*writes));
+    for (i = 0; i < write_count; i++)
+    {
+        infos = write_descriptor_infos(&writes[i], &info_size);
+        copy[i].pImageInfo = NULL;
+        copy[i].pBufferInfo = NULL;
+        copy[i].pTexelBufferView = NULL;
+        memcpy(extra, infos, writes[i].descriptorCount * info_size);
+        if (info_size == sizeof(*writes->pTexelBufferView))
+            copy[i].pTexelBufferView = (void *)extra;
+        else if (infos == (const void *)writes[i].pBufferInfo && writes[i].descriptorType >= VK_DESCRIPTOR_TYPE_UNIFORM_BUFFER
+                && writes[i].descriptorType <= VK_DESCRIPTOR_TYPE_STORAGE_BUFFER_DYNAMIC)
+            copy[i].pBufferInfo = (void *)extra;
+        else
+            copy[i].pImageInfo = (void *)extra;
+        extra += VK_BATCH_ALIGN(writes[i].descriptorCount * info_size);
+    }
+    return TRUE;
+}
