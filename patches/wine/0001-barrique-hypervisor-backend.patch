+/***********************************************************************
+ *              macdrv_app_name
+ *
+ * Barrique: the name the Dock and the menu bar show for this process instead of
+ * "wine": the program's FileDescription, else its ProductName, else its file
+ * name without the extension.
+ */
+static NTSTATUS WINAPI macdrv_app_name(void *arg, ULONG size)
+{
+    static const WCHAR *keys[] = { L"FileDescription", L"ProductName" };
+    WCHAR path[MAX_PATH], name[128] = {0}, query[64], *p, *value;
+    struct { WORD lang, codepage; } *trans;
+    UINT len, i;
+    DWORD info_size;
+    void *info;
+
+    if (!GetModuleFileNameW(NULL, path, ARRAY_SIZE(path))) return NtCallbackReturn(NULL, 0, 0);
+
+    if ((info_size = GetFileVersionInfoSizeW(path, NULL)) && (info = HeapAlloc(GetProcessHeap(), 0, info_size)))
+    {
+        if (GetFileVersionInfoW(path, 0, info_size, info) &&
+            VerQueryValueW(info, L"\\VarFileInfo\\Translation", (void **)&trans, &len) && len >= sizeof(*trans))
+        {
+            for (i = 0; i < ARRAY_SIZE(keys) && !name[0]; i++)
+            {
+                swprintf(query, ARRAY_SIZE(query), L"\\StringFileInfo\\%04x%04x\\%s", trans->lang, trans->codepage, keys[i]);
+                if (VerQueryValueW(info, query, (void **)&value, &len) && len > 1)
+                    lstrcpynW(name, value, ARRAY_SIZE(name));
+            }
+        }
+        HeapFree(GetProcessHeap(), 0, info);
+    }
+    if (!name[0])
+    {
+        p = wcsrchr(path, '\\');
+        lstrcpynW(name, p ? p + 1 : path, ARRAY_SIZE(name));
+        if ((p = wcsrchr(name, '.')) && !wcsicmp(p, L".exe")) *p = 0;
+    }
+    /* trim spaces some programs leave around their description */
+    for (p = name + wcslen(name); p > name && p[-1] == ' '; p--) p[-1] = 0;
+    TRACE("%s\n", debugstr_w(name));
+    return NtCallbackReturn(name, (wcslen(name) + 1) * sizeof(WCHAR), 0);
+}
