+    sync->type = INPROC_SYNC_MUTEX;
+    if (!(sync->msync = create_msync( owner, count, MSYNC_MUTEX )))
+    {
+        set_error( STATUS_NO_MEMORY );
+        release_object( sync );
+        return NULL;
+    }
+    return sync;
+}
+
+struct inproc_sync *create_inproc_semaphore_sync( unsigned int initial, unsigned int max )
+{
+    struct inproc_sync *sync;
+
+    if (!do_msync()) return NULL;
+    if (!(sync = alloc_object( &inproc_sync_ops ))) return NULL;
+    sync->type = INPROC_SYNC_SEMAPHORE;
+    if (!(sync->msync = create_msync( initial, max, MSYNC_SEMAPHORE )))
+    {
+        set_error( STATUS_NO_MEMORY );
+        release_object( sync );
+        return NULL;
+    }
+    return sync;
