+#if defined(__APPLE__) && defined(__aarch64__)
+/* On macOS arm64 Windows code runs in a Hypervisor.framework VM (see ntdll/unix/hvf.c).
+ * The host cannot map anything below 4GB, so memory that Windows sees at an address
+ * below 4GB (the 32-bit address space of WoW64 processes) lives at
+ * WINE_LOW_WINDOW_BASE + address on the host, and the VM maps it at both addresses.
+ * The base is a multiple of 4GB: truncating a host pointer gives the Windows address. */
+#define WINE_LOW_WINDOW_BASE 0xe000000000ULL
+
+/* Windows address -> host address. Values below 64K (atoms, resource ids, booleans) and
+ * from 0xfffe0000 up (blocked on WoW64; window procedure handles, -1) are left alone. */
+static inline void *wine_low_window_ptr( ULONG_PTR addr )
+{
+    if (addr >= 0x10000 && addr < 0xfffe0000) addr += WINE_LOW_WINDOW_BASE;
+    return (void *)addr;
+}
+
+/* 32-bit pointers from WoW64 structures are Windows addresses */
+#undef ULongToPtr
+#undef UlongToPtr
+#define ULongToPtr(ul) wine_low_window_ptr( (ULONG)(ul) )
+#define UlongToPtr(ul) wine_low_window_ptr( (ULONG)(ul) )
+#else
+static inline void *wine_low_window_ptr( ULONG_PTR addr ) { return (void *)addr; }
