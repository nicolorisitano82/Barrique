+static void d3d12_pipeline_state_learn_hint(struct d3d12_pipeline_state *state,
+        D3D12_PRIMITIVE_TOPOLOGY topology, const uint32_t *strides)
+{
+    const struct d3d12_graphics_pipeline_state *graphics = &state->u.graphics;
+    struct d3d12_device *device = state->device;
+    struct vkd3d_pso_hint *hint;
+
+    if (!pso_precompile_mode() || !graphics->attribute_count)
+        return;
+
+    vkd3d_mutex_lock(&device->pipeline_cache_mutex);
+    if ((hint = pso_hint_slot(device, graphics->layout_hash, true)))
+    {
+        hint->hash = graphics->layout_hash;
+        hint->topology = topology;
+        memcpy(hint->strides, strides, sizeof(hint->strides));
+    }
+    vkd3d_mutex_unlock(&device->pipeline_cache_mutex);
+}
