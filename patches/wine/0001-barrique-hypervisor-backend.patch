+ * matching signatures the vertex shader can write that output to Layer itself.
+ * Returns the VKD3D_SHADER_COMPILE_OPTION_BARRIQUE_VS_LAYER_OUTPUT value, 0 if the
+ * geometry shader is not such a pass-through. */
+static unsigned int passthrough_gs_layer_output(const struct d3d12_pipeline_state_desc *desc)
+{
