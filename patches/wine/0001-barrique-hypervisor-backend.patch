+
+/* Barrique: replay the commands the client batched, see wine_vk_batch_begin() */
+NTSTATUS vk_flush_command_batch(void *arg)
+{
+#ifdef _WIN64
+    extern const unixlib_entry_t __wine_unix_call_funcs[];
+    struct flush_command_batch_params *params = arg;
+    const BYTE *ptr = params->data, *end = ptr + params->size;
+
+    while (ptr + 8 <= end)
+    {
+        const UINT32 *header = (const UINT32 *)ptr;
+        if (header[0] >= unix_count || header[1] < 8 || header[1] > end - ptr)
+        {
+            ERR("corrupt command batch\n");
+            return STATUS_INVALID_PARAMETER;
+        }
+        if (batch_stats) InterlockedIncrement(&batch_stats[header[0]]);
+        __wine_unix_call_funcs[header[0]]((void *)(ptr + 8));
+        ptr += header[1];
+    }
+    if (batch_stats) print_batch_stats();
+    return STATUS_SUCCESS;
+#else
+    return STATUS_NOT_IMPLEMENTED;
+#endif
+}
+
+NTSTATUS vk_flush_command_batch32(void *arg)
+{
+    return STATUS_NOT_IMPLEMENTED;  /* 32-bit clients don't batch */
+}
