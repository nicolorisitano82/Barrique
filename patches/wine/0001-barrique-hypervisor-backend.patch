+/***********************************************************************
+ *		cef_in_process_gpu
+ *
+ * Barrique: CEF/Chromium browsers show a blank page under Wine on macOS unless
+ * their GPU process runs inside the browser process (MetalSharp's finding, also
+ * needed for Steam's steamwebhelper). For the browser process of a CEF program
+ * (libcef.dll next to the executable, or steamwebhelper.exe) without --type=,
+ * --in-process-gpu is appended to the command line. BARRIQUE_CEF_GPU=0 turns it off.
+ */
+static void cef_in_process_gpu( RTL_USER_PROCESS_PARAMETERS *params )
+{
+    static const WCHAR in_process_gpu[] = L" --in-process-gpu";
+    UNICODE_STRING *cmdline = &params->CommandLine, var = RTL_CONSTANT_STRING( L"BARRIQUE_CEF_GPU" ), value;
+    const WCHAR *image = params->ImagePathName.Buffer, *name;
+    WCHAR env[8], *path, *buf;
+    BOOL cef = FALSE;
+    SIZE_T dir_len;
+
+    if (!image || !cmdline->Buffer || !cmdline->Length) return;
+    value.Buffer = env;
+    value.MaximumLength = sizeof(env);
+    if (!RtlQueryEnvironmentVariable_U( NULL, &var, &value ) && value.Length == sizeof(WCHAR) && env[0] == '0')
+        return;
+    if (wcsstr( cmdline->Buffer, L"--type=" ) || wcsstr( cmdline->Buffer, L"--in-process-gpu" )) return;
+
+    name = (name = wcsrchr( image, '\\' )) ? name + 1 : image;
+    if (!wcsicmp( name, L"steamwebhelper.exe" )) cef = TRUE;
+    else
+    {
+        dir_len = name - image;
+        if (!(path = RtlAllocateHeap( GetProcessHeap(), 0, (dir_len + 12) * sizeof(WCHAR) ))) return;
+        memcpy( path, image, dir_len * sizeof(WCHAR) );
+        wcscpy( path + dir_len, L"libcef.dll" );
+        cef = RtlDoesFileExists_U( path );
+        RtlFreeHeap( GetProcessHeap(), 0, path );
+    }
+    if (!cef) return;
+
+    if (!(buf = RtlAllocateHeap( GetProcessHeap(), 0, cmdline->Length + sizeof(in_process_gpu) ))) return;
+    memcpy( buf, cmdline->Buffer, cmdline->Length );
+    memcpy( (char *)buf + cmdline->Length, in_process_gpu, sizeof(in_process_gpu) );
+    cmdline->Buffer = buf;
+    cmdline->Length += sizeof(in_process_gpu) - sizeof(WCHAR);
+    cmdline->MaximumLength = cmdline->Length + sizeof(WCHAR);
+    TRACE( "CEF browser %s: added --in-process-gpu\n", debugstr_w(name) );
+}
+
+
 /******************************************************************
  *		loader_init
  *
@@ -4474,6 +4522,7 @@ void loader_init( CONTEXT *context, void **entry )
             InitializeListHead( &hash_table[i] );
 
         init_user_process_params();
+        cef_in_process_gpu( peb->ProcessParameters );
         load_global_options();
         version_init();
         open_known_dll_ntdir();
@@ -4521,7 +4570,13 @@ void loader_init( CONTEXT *context, void **entry )
     else
     {
 #ifdef _WIN64
-        if (NtCurrentTeb()->WowTebOffset && !((ULONG_PTR)*entry >> 32)) init_wow64( context );
+        if (NtCurrentTeb()->WowTebOffset)
+        {
+            /* a 32-bit thread starts in the 32-bit address space; on hosts that cannot map
+             * the low 4GB that space is a 4GB-aligned window holding the 32-bit TEB */
+            ULONG_PTR low_base = ((ULONG_PTR)NtCurrentTeb() + NtCurrentTeb()->WowTebOffset) & ~(ULONG_PTR)0xffffffff;
+            if (!(((ULONG_PTR)*entry - low_base) >> 32)) init_wow64( context );
+        }
 #endif
