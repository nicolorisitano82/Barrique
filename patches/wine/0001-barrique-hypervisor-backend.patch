+    frame->lr   = lr;
+    frame->sp   = regs->sp;
+    frame->pc   = pc;
+    frame->cpsr = regs->cpsr;
+    frame->restore_flags = 0;
+    frame->syscall_id = regs->x[8];
+    frame->fpcr = regs->fpcr;
+    frame->fpsr = regs->fpsr;
