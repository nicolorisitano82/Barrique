+        {
+            const BYTE *src = map.pData;
+            size_t i;
+            for (i = 0; i < (size_t)map.RowPitch * desc.Height; i += 4)
+            {
+                bits[i] = src[i + 2];
+                bits[i + 1] = src[i + 1];
+                bits[i + 2] = src[i];
+                bits[i + 3] = src[i + 3];
+            }
+        }
+        if (bits)
+        {
+            info.bmiHeader.biSize = sizeof(info.bmiHeader);
+            info.bmiHeader.biWidth = map.RowPitch / 4;
+            info.bmiHeader.biHeight = -(LONG)desc.Height;
+            info.bmiHeader.biPlanes = 1;
+            info.bmiHeader.biBitCount = 32;
+            info.bmiHeader.biCompression = BI_RGB;
+            {
+                /* follow the target window, which Chromium resizes without a new Commit */
+                HWND parent = GetAncestor(swapchain->composition_window, GA_PARENT);
+                RECT parent_rect, rect;
+
+                if (parent && parent != GetDesktopWindow() && GetClientRect(parent, &parent_rect)
+                        && GetWindowRect(swapchain->composition_window, &rect)
+                        && (rect.right - rect.left != parent_rect.right || rect.bottom - rect.top != parent_rect.bottom))
+                    SetWindowPos(swapchain->composition_window, NULL, 0, 0, parent_rect.right, parent_rect.bottom,
+                            SWP_NOZORDER | SWP_NOACTIVATE);
+            }
+            if ((dc = GetDC(swapchain->composition_window)))
+            {
+                /* with dirty rects (Present1), the rest of the buffer may be stale:
+                 * keep what the window already shows there */
+                if (params && params->DirtyRectsCount && params->pDirtyRects)
+                {
+                    UINT i;
+                    for (i = 0; i < params->DirtyRectsCount; ++i)
+                    {
+                        RECT r = params->pDirtyRects[i];
+                        r.left = max(r.left, 0);
+                        r.top = max(r.top, 0);
+                        r.right = min(r.right, (LONG)desc.Width);
+                        r.bottom = min(r.bottom, (LONG)desc.Height);
+                        if (r.left >= r.right || r.top >= r.bottom) continue;
+                        /* the source origin is the bottom left, also for a top-down DIB */
+                        StretchDIBits(dc, r.left, r.top, r.right - r.left, r.bottom - r.top,
