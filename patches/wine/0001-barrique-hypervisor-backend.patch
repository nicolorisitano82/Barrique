+                                bits, &info, DIB_RGB_COLORS, SRCCOPY);
+                    }
+                }
+                else
+                    SetDIBitsToDevice(dc, 0, 0, desc.Width, desc.Height, 0, 0, 0, desc.Height, bits, &info, DIB_RGB_COLORS);
+                ReleaseDC(swapchain->composition_window, dc);
+                GdiFlush();
