+        else if (e->sysval_semantic == VKD3D_SHADER_SV_RENDER_TARGET_ARRAY_INDEX)
+            has_layer_out = true;
+        else if (e->sysval_semantic != VKD3D_SHADER_SV_NONE && e->sysval_semantic != VKD3D_SHADER_SV_POSITION)
+            ok = false;
