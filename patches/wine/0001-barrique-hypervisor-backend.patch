diff --git a/dlls/advapi32/security.c b/dlls/advapi32/security.c
index b6f91af..1ad7ce8 100644
--- a/dlls/advapi32/security.c
+++ b/dlls/advapi32/security.c
@@ -3094,6 +3094,24 @@ DWORD WINAPI SetSecurityInfo(HANDLE handle, SE_OBJECT_TYPE ObjectType,
     case SE_WMIGUID_OBJECT:
     case SE_REGISTRY_KEY:
         status = NtSetSecurityObject(handle, SecurityInfo, &sd);
+        /* Barrique: Google Updater creates a key with KEY_WRITE and then sets its DACL
+         * through that handle, which works on Windows. Retry through a duplicate that
+         * asks for the needed rights; the server checks them against the key's
+         * security (the owner always gets WRITE_DAC). */
+        if (status == STATUS_ACCESS_DENIED && ObjectType == SE_REGISTRY_KEY)
+        {
+            ACCESS_MASK access = 0;
+            HANDLE dup;
+
+            if (SecurityInfo & DACL_SECURITY_INFORMATION) access |= WRITE_DAC;
+            if (SecurityInfo & (OWNER_SECURITY_INFORMATION | GROUP_SECURITY_INFORMATION)) access |= WRITE_OWNER;
+            if (SecurityInfo & SACL_SECURITY_INFORMATION) access |= ACCESS_SYSTEM_SECURITY;
+            if (!NtDuplicateObject( NtCurrentProcess(), handle, NtCurrentProcess(), &dup, access, 0, 0 ))
+            {
+                status = NtSetSecurityObject(dup, SecurityInfo, &sd);
+                NtClose( dup );
+            }
+        }
         break;
 
     default:
