diff --git a/dlls/wow64/wow64_private.h b/dlls/wow64/wow64_private.h
index e7c17fc..1787de6 100644
--- a/dlls/wow64/wow64_private.h
+++ b/dlls/wow64/wow64_private.h
@@ -77,6 +77,33 @@ static inline TEB32 *NtCurrentTeb32(void)
     return (TEB32 *)((char *)NtCurrentTeb() + NtCurrentTeb()->WowTebOffset);
 }
 
+/* Where the 32-bit address space is in the 64-bit view. Normally at 0, but a host
+ * that cannot map the low 4GB (macOS on arm64) puts it in a 4GB-aligned window
+ * higher up, with the 32-bit TEB inside it; the 32-bit code still sees it at 0. */
+static inline ULONG_PTR wow64_low_base(void)
+{
+    return (ULONG_PTR)NtCurrentTeb32() & ~(ULONG_PTR)0xffffffff;
+}
+
+/* 32-bit pointer -> 64-bit pointer. Values below 64K (atoms, resource ids, booleans)
+ * and from 0xfffe0000 up (window procedure handles, -1) are not real addresses. */
+static inline void *wow64_ptr( ULONG ul )
+{
+    return (ul >= 0x10000 && ul < 0xfffe0000) ? (void *)(wow64_low_base() + ul) : (void *)(ULONG_PTR)ul;
+}
+#undef ULongToPtr
+#undef UlongToPtr
+#define ULongToPtr(ul) wow64_ptr( (ULONG)(ul) )
+#define UlongToPtr(ul) wow64_ptr( (ULONG)(ul) )
+
+/* 64-bit pointer -> the address the 32-bit code uses, as the CPU backend (BTCpu*)
+ * expects it: pointers into the 32-bit address space are below 4GB on Windows */
+static inline void *wow64_guest_ptr( const void *ptr )
+{
+    ULONG_PTR base = wow64_low_base(), p = (ULONG_PTR)ptr;
+    return (void *)(p - base < 0x100000000ULL ? p - base : p);
+}
+
 static inline ULONG get_ulong( UINT **args ) { return *(*args)++; }
 static inline HANDLE get_handle( UINT **args ) { return LongToHandle( *(*args)++ ); }
 static inline void *get_ptr( UINT **args ) { return ULongToPtr( *(*args)++ ); }
