diff --git a/dlls/winemac.drv/cocoa_dxmt.m b/dlls/winemac.drv/cocoa_dxmt.m
new file mode 100644
index 0000000..aa0f614
--- /dev/null
+++ b/dlls/winemac.drv/cocoa_dxmt.m
@@ -0,0 +1,166 @@
+/*
+ * Barrique: Windows memory for DXMT's Metal buffers
+ *
+ * DXMT (D3D10/11 on Metal) is used unmodified. Its unix library winemetal.so
+ * creates most CPU-visible buffers with -[MTLDevice newBufferWithLength:options:]
+ * and hands [buffer contents] to the Windows side. Under the Hypervisor.framework
+ * backend Windows code runs in a VM that only maps Windows memory, and memory
+ * Metal allocated itself, mapped into the VM by hand, keeps its old pages after
+ * Metal frees it (research/hvproto/gpumap.m, case 6).
+ *
+ * So when winemetal.so is loaded, its import of MTLCopyAllDevices is pointed at
+ * a wrapper that swizzles newBufferWithLength:options: on the device classes it
+ * returns. For calls coming from winemetal.so, and storage that is not private,
+ * the buffer is created with newBufferWithBytesNoCopy over a Windows view
+ * (macdrv_dxmt_alloc); its deallocator gives the view back. Calls from anywhere
+ * else (MoltenVK, Metal itself) are untouched. Same strategy as win32u's Vulkan
+ * memory under HVF (phase 5 step 4).
+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ */
+
+#import <Metal/Metal.h>
+#import <objc/runtime.h>
+#include <dlfcn.h>
+#include <mach/mach.h>
+#include <mach-o/dyld.h>
+#include <mach-o/getsect.h>
+#include <pthread.h>
+#include <string.h>
+#include <stdio.h>
+#include <stdlib.h>
+
+#import "macdrv_cocoa.h"
+
+#define DXMT_PAGE 0x4000
+
+typedef NSArray<id<MTLDevice>> *(*copy_all_devices_func)(void);
+typedef id (*new_buffer_func)(id self, SEL sel, NSUInteger length, MTLResourceOptions options);
+
+static copy_all_devices_func real_copy_all_devices;
+static uintptr_t winemetal_start, winemetal_end;
+static pthread_mutex_t swizzle_lock = PTHREAD_MUTEX_INITIALIZER;
+
+/* the original newBufferWithLength:options: of each swizzled class */
+static struct { Class cls; new_buffer_func orig; } swizzled[8];
+static unsigned int swizzled_count;
+
+static new_buffer_func original_for(id self)
+{
+    Class cls = object_getClass(self);
+    unsigned int i;
+
+    for (; cls; cls = class_getSuperclass(cls))
+        for (i = 0; i < swizzled_count; i++)
+            if (swizzled[i].cls == cls) return swizzled[i].orig;
+    return NULL;
+}
+
+static id dxmt_new_buffer(id self, SEL sel, NSUInteger length, MTLResourceOptions options)
+{
+    uintptr_t caller = (uintptr_t)__builtin_return_address(0);
+    new_buffer_func orig = original_for(self);
+    void *host, *windows_addr;
+    NSUInteger size;
+    id buffer;
+
+    if (!orig) return nil;
+    if (caller < winemetal_start || caller >= winemetal_end || !length ||
+        (options & MTLResourceStorageModeMask) == MTLResourceStorageModePrivate)
+        return orig(self, sel, length, options);
+
+    size = (length + DXMT_PAGE - 1) & ~(NSUInteger)(DXMT_PAGE - 1);
+    if (!(host = macdrv_dxmt_alloc(size, &windows_addr))) return orig(self, sel, length, options);
+
+    buffer = [(id<MTLDevice>)self newBufferWithBytesNoCopy:host length:size options:options
+                                               deallocator:^(void *pointer, NSUInteger len) {
+        macdrv_dxmt_free(windows_addr);
+    }];
+    if (!buffer)
+    {
+        macdrv_dxmt_free(windows_addr);
+        return orig(self, sel, length, options);
+    }
+    return buffer;
+}
+
+static void swizzle_device(id<MTLDevice> device)
+{
+    SEL sel = @selector(newBufferWithLength:options:);
+    Class cls = object_getClass(device);
+    Method method;
+    unsigned int i;
+
+    pthread_mutex_lock(&swizzle_lock);
+    for (i = 0; i < swizzled_count; i++) if (swizzled[i].cls == cls) goto done;
+    if (swizzled_count == sizeof(swizzled) / sizeof(swizzled[0])) goto done;
+    if (!(method = class_getInstanceMethod(cls, sel))) goto done;
+    /* own the method in this class, so a superclass shared with others stays as is */
+    class_addMethod(cls, sel, method_getImplementation(method), method_getTypeEncoding(method));
+    method = class_getInstanceMethod(cls, sel);
+    swizzled[swizzled_count].cls = cls;
+    swizzled[swizzled_count].orig = (new_buffer_func)method_getImplementation(method);
+    swizzled_count++;
+    method_setImplementation(method, (IMP)dxmt_new_buffer);
+    fprintf(stderr, "barrique: DXMT buffers of %s use Windows memory\n", class_getName(cls));
+done:
+    pthread_mutex_unlock(&swizzle_lock);
+}
+
+static NSArray<id<MTLDevice>> *dxmt_copy_all_devices(void)
+{
+    NSArray<id<MTLDevice>> *devices = real_copy_all_devices();
+    for (id<MTLDevice> device in devices) swizzle_device(device);
+    return devices;
+}
+
+/* point winemetal.so's resolved import of MTLCopyAllDevices at the wrapper */
+static void hook_winemetal(const struct mach_header_64 *header, intptr_t slide)
+{
+    unsigned long got_size, text_size;
+    void **got = (void **)getsectiondata(header, "__DATA_CONST", "__got", &got_size);
+    uint8_t *text = getsegmentdata(header, "__TEXT", &text_size);
+    unsigned int i, count = 0;
+
+    if (!real_copy_all_devices || !got || !text) return;
+    winemetal_start = (uintptr_t)text;
+    winemetal_end = (uintptr_t)text + text_size;
+
+    for (i = 0; i < got_size / sizeof(void *); i++)
+    {
+        vm_address_t page;
+        if (got[i] != (void *)real_copy_all_devices) continue;
+        page = (vm_address_t)&got[i] & ~(vm_address_t)(vm_page_size - 1);
+        if (vm_protect(mach_task_self(), page, vm_page_size, FALSE,
+                       VM_PROT_READ | VM_PROT_WRITE | VM_PROT_COPY) != KERN_SUCCESS)
+            continue;
+        got[i] = (void *)dxmt_copy_all_devices;
+        vm_protect(mach_task_self(), page, vm_page_size, FALSE, VM_PROT_READ);
+        count++;
+    }
+    fprintf(stderr, "barrique: winemetal.so loaded, %u MTLCopyAllDevices import(s) hooked\n", count);
+}
+
+static void image_added(const struct mach_header *header, intptr_t slide)
+{
+    Dl_info info;
+    size_t len;
+
+    if (!dladdr(header, &info) || !info.dli_fname) return;
+    len = strlen(info.dli_fname);
+    if (len < 13 || strcmp(info.dli_fname + len - 13, "/winemetal.so")) return;
+    hook_winemetal((const struct mach_header_64 *)header, slide);
+}
+
+static void __attribute__((constructor)) dxmt_init(void)
+{
+    const char *env = getenv("BARRIQUE_DXMT_BUFFERS");
+
+    if (env && !strcmp(env, "0")) return;
+    real_copy_all_devices = (copy_all_devices_func)dlsym(RTLD_DEFAULT, "MTLCopyAllDevices");
+    if (!real_copy_all_devices) return;
+    _dyld_register_func_for_add_image(image_added);
+}
