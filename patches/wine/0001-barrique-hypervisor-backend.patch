diff --git a/dlls/dnsapi/libresolv.c b/dlls/dnsapi/libresolv.c
index dd9b32d..6eb2acc 100644
--- a/dlls/dnsapi/libresolv.c
+++ b/dlls/dnsapi/libresolv.c
@@ -44,6 +44,10 @@
 #ifdef HAVE_NETDB_H
 # include <netdb.h>
 #endif
+#ifdef __APPLE__
+# include <ifaddrs.h>
+# include <net/if.h>
+#endif
 
 #include "ntstatus.h"
 #include "windef.h"
@@ -339,6 +343,37 @@ static NTSTATUS get_hostinfo( void *args )
 
     if (gethostname( params->name, DNS_MAX_NAME_LENGTH )) return map_h_errno( h_errno );
 
+#ifdef __APPLE__
+    /* macOS names the machine "<name>.local": resolving it goes through multicast DNS,
+     * which can wait 5 seconds when nobody answers, at every process start. Our own
+     * addresses are on our own interfaces. */
+    {
+        size_t len = strlen( params->name );
+        struct ifaddrs *ifaddrs, *ifa;
+        BOOL have_ip6 = FALSE;
+
+        if (len > 6 && !strcasecmp( params->name + len - 6, ".local" ) && !getifaddrs( &ifaddrs ))
+        {
+            strcpy( params->cname, params->name );
+            for (ifa = ifaddrs; ifa; ifa = ifa->ifa_next)
+            {
+                if (!ifa->ifa_addr || (ifa->ifa_flags & IFF_LOOPBACK) || !(ifa->ifa_flags & IFF_UP)) continue;
+                if (ifa->ifa_addr->sa_family == AF_INET && !*params->ip4)
+                    *params->ip4 = ((struct sockaddr_in *)ifa->ifa_addr)->sin_addr.s_addr;
+                else if (ifa->ifa_addr->sa_family == AF_INET6 && !have_ip6 &&
+                         !IN6_IS_ADDR_LINKLOCAL( &((struct sockaddr_in6 *)ifa->ifa_addr)->sin6_addr ))
+                {
+                    memcpy( params->ip6, ((struct sockaddr_in6 *)ifa->ifa_addr)->sin6_addr.s6_addr,
+                            sizeof(*params->ip6) );
+                    have_ip6 = TRUE;
+                }
+            }
+            freeifaddrs( ifaddrs );
+            return ERROR_SUCCESS;
+        }
+    }
+#endif
+
     if (!getaddrinfo( params->name, NULL, &hints, &result ))
     {
         if (result->ai_canonname) strcpy( params->cname, result->ai_canonname );
