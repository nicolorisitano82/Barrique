+#ifdef __APPLE__
+/* Barrique: writing a big registry branch takes the single-threaded server
+ * 50 ms or more, and every client waits meanwhile (audio events arrive late
+ * and the device underruns). The periodic save runs in a forked child, which
+ * writes the snapshot of the registry taken by fork(); the server goes on.
+ * flush_registry() still saves synchronously, after waiting for the child. */
+static pid_t save_pid;                    /* child doing a periodic save */
+static unsigned int save_pid_branches;    /* branches it saves (bit mask) */
+
+/* the save child exited: if it failed, its branches must be saved again */
+void registry_save_child_exited( pid_t pid, int status )
+{
+    int i;
+
+    if (!save_pid || pid != save_pid) return;
+    save_pid = 0;
+    if (WIFEXITED(status) && !WEXITSTATUS(status)) return;
+    for (i = 0; i < save_branch_count; i++)
+        if (save_pid_branches & (1u << i)) make_dirty( save_branch_info[i].key );
+}
+
+static void wait_save_child(void)
+{
+    int status;
+    pid_t pid;
+
+    while (save_pid)
+    {
+        pid = waitpid( save_pid, &status, 0 );
+        if (pid == save_pid) registry_save_child_exited( pid, status );
+        else if (pid == -1 && errno != EINTR) save_pid = 0;  /* already reaped */
+    }
+}
+
+static int fork_periodic_save(void)
+{
+    unsigned int branches = 0;
+    pid_t pid;
+    int i, ok = 1;
+
+    if (save_pid) return 1;  /* the previous save is still running */
+    for (i = 0; i < save_branch_count; i++)
+        if (save_branch_info[i].key->flags & KEY_DIRTY) branches |= 1u << i;
+    if (!branches) return 1;
+
+    if ((pid = fork()) == -1) return 0;
+    if (!pid)  /* child: write the snapshot and leave */
+    {
+        for (i = 0; i < save_branch_count; i++)
+            if ((branches & (1u << i)) && !save_branch( save_branch_info[i].key, save_branch_info[i].filename ))
+                ok = 0;
+        _exit( ok ? 0 : 1 );
+    }
+    /* the child has these contents: changes from now on dirty the keys again */
+    save_pid = pid;
+    save_pid_branches = branches;
+    for (i = 0; i < save_branch_count; i++)
+        if (branches & (1u << i)) make_clean( save_branch_info[i].key );
+    return 1;
+}
+#endif
