+/* Barrique: LaunchServices keeps the name the Dock (and the application switcher)
+ * shows for a running process; for a process outside a bundle it is its executable
+ * name, "wine". The private _LSSetApplicationInformationItem with _kLSDisplayNameKey
+ * changes it, as Chromium does for its helper processes. Looked up at run time: if
+ * a macOS release drops it, the name simply stays. */
+static void set_launch_services_display_name(NSString* name)
+{
+    typedef CFTypeRef (*get_asn_func)(void);
+    typedef OSStatus (*set_item_func)(int, CFTypeRef, CFStringRef, CFStringRef, CFDictionaryRef*);
+    static get_asn_func get_asn;
+    static set_item_func set_item;
+    static CFStringRef display_name_key;
+    static dispatch_once_t once;
+
+    dispatch_once(&once, ^{
+        CFBundleRef bundle = CFBundleGetBundleWithIdentifier(CFSTR("com.apple.LaunchServices"));
+        CFStringRef *key;
+
+        if (!bundle) return;
+        get_asn = (get_asn_func)CFBundleGetFunctionPointerForName(bundle, CFSTR("_LSGetCurrentApplicationASN"));
+        set_item = (set_item_func)CFBundleGetFunctionPointerForName(bundle, CFSTR("_LSSetApplicationInformationItem"));
+        key = (CFStringRef*)CFBundleGetDataPointerForName(bundle, CFSTR("_kLSDisplayNameKey"));
+        if (key) display_name_key = *key;
+    });
+
+    if (get_asn && set_item && display_name_key)
+    {
+        CFTypeRef asn = get_asn();
+        if (asn) set_item(-2 /* kLSDefaultSessionID */, asn, display_name_key, (CFStringRef)name, NULL);
+    }
+}
+
+/***********************************************************************
+ *              macdrv_set_application_name
+ *
+ * Barrique: show the Windows program's name instead of "wine" in the Dock, the
+ * application switcher and the application menu.
+ */
+void macdrv_set_application_name(CFStringRef name)
+{
+    NSString* appName = [(NSString*)name copy];
+
+    OnMainThreadAsync(^{
+        NSMenuItem* item = [[NSApp mainMenu] numberOfItems] ? [[NSApp mainMenu] itemAtIndex:0] : nil;
+
+        set_launch_services_display_name(appName);
+        if ([item submenu]) [[item submenu] setTitle:appName];
+        [appName release];
+    });
+}
