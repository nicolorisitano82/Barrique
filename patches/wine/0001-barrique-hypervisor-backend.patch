+/* Barrique: the window surface of a child window whose parent belongs to
+ * another process (e.g. a WebView2 browser window inside its host's window).
+ * There is no Cocoa window to draw into here: export a layer tree with
+ * CAContext and let the root window's owner host it with CALayerHost, as
+ * CAContextSwapChain does for Metal. The container covers the host's content
+ * view; the clip layer sits at the child window's place in it. */
+@interface WineRemoteSurface : NSObject
+{
+@public
+    CAContext* context;
+    CALayer* container;
+    CALayer* clip;
+    CALayer* content;
+}
+@end
+
+@implementation WineRemoteSurface
+@end
+
+void* macdrv_create_remote_surface(unsigned int* context_id)
+{
+@autoreleasepool
+{
+    WineRemoteSurface* remote = [[WineRemoteSurface alloc] init];
+
+    *context_id = 0;
+    OnMainThread(^{
+        [CATransaction begin];
+        [CATransaction setDisableActions:YES];
+        remote->container = [[CALayer alloc] init];
+        remote->container.anchorPoint = CGPointZero;
+        remote->container.frame = CGRectMake(0, 0, 1, 1);
+        remote->container.geometryFlipped = YES;  /* Win32 coordinates: origin at the top left */
+        remote->clip = [[CALayer alloc] init];
+        remote->clip.anchorPoint = CGPointZero;
+        remote->clip.masksToBounds = YES;
+        remote->content = [[CALayer alloc] init];
+        remote->content.anchorPoint = CGPointZero;
+        remote->content.contentsGravity = kCAGravityTopLeft;
+        remote->content.contentsScale = retina_on ? 2.0 : 1.0;
+        remote->content.magnificationFilter = kCAFilterNearest;
+        [remote->clip addSublayer:remote->content];
+        [remote->container addSublayer:remote->clip];
+        remote->context = [[CAContext contextWithCGSConnection:CGSMainConnectionID()
+                                                       options:[NSDictionary dictionary]] retain];
+        [remote->context setLayer:remote->container];
+        [CATransaction commit];
+        [CATransaction flush];
+    });
+    if (!remote->context || !(*context_id = [remote->context contextId]))
+    {
+        macdrv_destroy_remote_surface(remote);
+        return NULL;
+    }
+    return remote;
+}
+}
+
+void macdrv_remote_surface_update(void* r, IOSurfaceRef s, CGRect container_rect, CGRect clip_rect, CGRect content_rect)
+{
+@autoreleasepool
+{
+    WineRemoteSurface* remote = r;
+    IOSurface* surface = (IOSurface*)s;
+
+    [surface retain];
+    OnMainThreadAsync(^{
+        [CATransaction begin];
+        [CATransaction setDisableActions:YES];
+        remote->container.frame = cgrect_mac_from_win(container_rect);
+        remote->clip.frame = cgrect_mac_from_win(clip_rect);
+        remote->content.frame = cgrect_mac_from_win(content_rect);
+        remote->content.contents = surface;
+        [CATransaction commit];
+        [CATransaction flush];
+        [surface release];
+    });
+}
+}
+
+void macdrv_destroy_remote_surface(void* r)
+{
+@autoreleasepool
+{
+    WineRemoteSurface* remote = r;
+
+    OnMainThreadAsync(^{
+        [remote->context setLayer:nil];
+        [remote->context release];
+        [remote->content release];
+        [remote->clip release];
+        [remote->container release];
+        [remote release];
+    });
+}
+}
