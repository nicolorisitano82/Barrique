+/* Barrique: where a remote surface goes in its root window's content view, in
+ * raw pixels relative to the top left of that view (the root's visible rect). */
+static void get_remote_surface_rects(struct macdrv_window_surface *surface, RECT *container, RECT *clip, RECT *content)
+{
+    HWND hwnd = surface->header.hwnd;
+    UINT dpi = NtUserGetWinMonitorDpi(hwnd, MDT_RAW_DPI);
+    RECT child, root, win = {0}, vis = {0};
+    int dx = 0, dy = 0;
+
+    NtUserGetWindowRect(hwnd, &child, dpi);
+    NtUserGetWindowRect(surface->root, &root, dpi);
+    /* the visible rect of the root (what its Cocoa content view shows) is only in
+     * the server, in the root's own coordinates: scale its offset to raw pixels */
+    SERVER_START_REQ(get_window_rectangles)
+    {
+        req->handle = wine_server_user_handle(surface->root);
+        req->relative = COORDS_SCREEN;
+        if (!wine_server_call(req))
+        {
+            win = wine_server_get_rect(reply->window);
+            vis = wine_server_get_rect(reply->visible);
+        }
+    }
+    SERVER_END_REQ;
+    if (win.right > win.left && win.bottom > win.top)
+    {
+        dx = (int)((LONGLONG)(vis.left - win.left) * (root.right - root.left) / (win.right - win.left));
+        dy = (int)((LONGLONG)(vis.top - win.top) * (root.bottom - root.top) / (win.bottom - win.top));
+    }
+    SetRect(container, 0, 0, root.right - root.left - dx, root.bottom - root.top - dy);
+    *clip = child;
+    OffsetRect(clip, -(root.left + dx), -(root.top + dy));
+    *content = surface->header.rect;
+    OffsetRect(content, clip->left, clip->top);
