+static ULONG64 hvf_dispatch_syscall( struct thread_data *data, const struct hvf_regs *regs )
+{
+    typedef ULONG_PTR (*syscall_func)( ULONG_PTR, ULONG_PTR, ULONG_PTR, ULONG_PTR, ULONG_PTR,
+                                       ULONG_PTR, ULONG_PTR, ULONG_PTR, ULONG_PTR, ULONG_PTR,
+                                       ULONG_PTR, ULONG_PTR, ULONG_PTR, ULONG_PTR, ULONG_PTR,
+                                       ULONG_PTR, ULONG_PTR, ULONG_PTR, ULONG_PTR, ULONG_PTR );
+    SYSTEM_SERVICE_TABLE *table = get_teb_data( data )->syscall_table + ((regs->x[8] >> 12) & 3);
+    ULONG id = regs->x[8] & 0xfff;
+    ULONG_PTR args[20];
+    unsigned int i, nstack = 0;
+    syscall_func func;
+
+    if (id >= table->ServiceLimit)
+    {
+        WARN( "bad syscall %#llx\n", (unsigned long long)regs->x[8] );
+        return STATUS_INVALID_SYSTEM_SERVICE;
+    }
+    {
+        extern LONG *hvf_syscall_hist;
+        if (hvf_syscall_hist) InterlockedIncrement( &hvf_syscall_hist[((regs->x[8] >> 12) & 3) << 12 | id] );
+    }
+    if (table->ArgumentTable[id] > 64) nstack = (table->ArgumentTable[id] - 64) / 8;
+    if (nstack > 12) nstack = 12;
+    memset( args, 0, sizeof(args) );
+    for (i = 0; i < 8; i++) args[i] = regs->x[i];
+    for (i = 0; i < nstack; i++) args[8 + i] = ((ULONG_PTR *)regs->sp)[i];  /* guest VA == host VA */
+
+    func = (syscall_func)table->ServiceTable[id];
+    /* a thread that is going to wait doesn't need its vCPU meanwhile */
+    if (table == get_teb_data( data )->syscall_table && is_wait_syscall( func ))
+    {
+        NTSTATUS status;
+        int idx = wait_syscall_timeout_arg( func );
+        const LARGE_INTEGER *timeout = idx >= 0 ? (const LARGE_INTEGER *)args[idx] : NULL;
+        /* a zero or short timeout (spin loops calling Sleep(0) or polling a handle) gets
+         * the thread running again right away: creating a new vCPU would cost more */
+        BOOL short_wait = timeout && timeout->QuadPart <= 0 && timeout->QuadPart > -20000;
+
+        if (!short_wait && hvf_vcpu_should_release())
+        {
+            hvf_sync_fp();  /* the FP state goes away with the vCPU */
+            hvf_release_vcpu();
+        }
+        hvf_wait_begin();
+        status = func( args[0], args[1], args[2], args[3], args[4], args[5], args[6], args[7], args[8], args[9],
+                       args[10], args[11], args[12], args[13], args[14], args[15], args[16], args[17], args[18], args[19] );
+        hvf_wait_end();
+        return status;
+    }
+    return func( args[0], args[1], args[2], args[3], args[4], args[5], args[6], args[7], args[8], args[9],
+                 args[10], args[11], args[12], args[13], args[14], args[15], args[16], args[17], args[18], args[19] );
+}
