+#ifdef WINE_HVF
+/***********************************************************************
+ *           hvf_windows_syscall_stubs
+ *
+ * Give ntdll's ARM64 syscall stubs the shape Windows has, svc #id; ret, which
+ * hvf_run() reports as HVF_EXIT_SVC. Code that checks the stubs before hooking
+ * them, such as the Chromium sandbox used by Firefox and Chrome (it wants
+ * svc #N; ret; 8 zero bytes, and fails every child process launch otherwise),
+ * then accepts them. Only under HVF: outside the VM svc would reach macOS.
+ * Wine's stub is mov x8, #id; mov x9, x30; ldr x16, 1f; ldr x16, [x16];
+ * blr x16; ret; 1: .quad, its first 16 bytes are replaced.
+ */
+static void hvf_windows_syscall_stubs( HMODULE module, const IMAGE_EXPORT_DIRECTORY *exports )
+{
+    const DWORD *functions = get_rva( module, exports->AddressOfFunctions );
+    char *start = NULL, *end = NULL;
+    unsigned int i, count = 0;
+    void *addr;
+    SIZE_T size;
+    ULONG old;
+
+    for (i = 0; i < exports->NumberOfFunctions; i++)
+    {
+        const UINT *code = get_rva( module, functions[i] );
+        if (!functions[i] || (code[0] & 0xffe0001f) != 0xd2800008 || code[1] != 0xaa1e03e9 ||
+            code[2] != 0x58000090 || code[3] != 0xf9400210 || code[4] != 0xd63f0200 || code[5] != 0xd65f03c0)
+            continue;
+        if (!start || (char *)code < start) start = (char *)code;
+        if ((char *)code + 16 > end) end = (char *)code + 16;
+    }
+    if (!start) return;
+
+    addr = start;
+    size = end - start;
+    if (NtProtectVirtualMemory( NtCurrentProcess(), &addr, &size, PAGE_EXECUTE_READWRITE, &old ))
+    {
+        ERR( "can't make the syscall stubs writable\n" );
+        return;
+    }
+    for (i = 0; i < exports->NumberOfFunctions; i++)
+    {
+        UINT *code = get_rva( module, functions[i] );
+        UINT id;
+        if (!functions[i] || (char *)code < start || (char *)code >= end) continue;
+        if ((code[0] & 0xffe0001f) != 0xd2800008 || code[1] != 0xaa1e03e9 || code[2] != 0x58000090) continue;
+        id = (code[0] >> 5) & 0xffff;
+        if (id >= HVF_SVC_WINE_SYSCALL) continue;
+        code[0] = 0xd4000001 | (id << 5);  /* svc #id */
+        code[1] = 0xd65f03c0;              /* ret */
+        code[2] = code[3] = 0;
+        count++;
+    }
+    __builtin___clear_cache( start, end );
+    NtProtectVirtualMemory( NtCurrentProcess(), &addr, &size, old, &old );
+    TRACE( "%u syscall stubs\n", count );
+}
+#endif
