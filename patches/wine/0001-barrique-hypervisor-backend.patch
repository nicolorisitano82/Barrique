diff --git a/dlls/ntdll/time.c b/dlls/ntdll/time.c
index 5a96a1e..46fa665 100644
--- a/dlls/ntdll/time.c
+++ b/dlls/ntdll/time.c
@@ -372,6 +372,27 @@ LONGLONG WINAPI RtlGetSystemTimePrecise( void )
 {
     LONGLONG ret;
 
+#if defined(__aarch64__) || defined(__arm64ec__)
+    /* Barrique: under Hypervisor.framework every syscall leaves the VM, and games
+     * read the time thousands of times per second; derive it from the performance
+     * counter (read in the VM), with the offset to the real time measured again
+     * every second */
+    if (user_shared_data->QpcFrequency == TICKSPERSEC)
+    {
+        static LONGLONG offset, next_calibration;
+        LARGE_INTEGER counter, now, after;
+
+        RtlQueryPerformanceCounter( &counter );
+        if (counter.QuadPart < ReadAcquire64( &next_calibration ))
+            return counter.QuadPart + ReadNoFence64( &offset );
+
+        NtQuerySystemTime( &now );
+        RtlQueryPerformanceCounter( &after );
+        WriteNoFence64( &offset, now.QuadPart - (counter.QuadPart + after.QuadPart) / 2 );
+        WriteRelease64( &next_calibration, after.QuadPart + TICKSPERSEC );
+        return now.QuadPart;
+    }
+#endif
     WINE_UNIX_CALL( unix_system_time_precise, &ret );
     return ret;
 }
@@ -381,6 +402,22 @@ LONGLONG WINAPI RtlGetSystemTimePrecise( void )
  */
 BOOL WINAPI DECLSPEC_HOTPATCH RtlQueryPerformanceCounter( LARGE_INTEGER *counter )
 {
+#if defined(__aarch64__) || defined(__arm64ec__)
+    /* Barrique: under Hypervisor.framework every syscall leaves the VM; the server
+     * publishes the bias from the ARM counter (see set_user_shared_data_time()) */
+    if (user_shared_data->QpcFrequency == TICKSPERSEC)
+    {
+        ULONGLONG ticks, freq;
+
+        __asm__ __volatile__( "isb; mrs %0, cntvct_el0" : "=r" (ticks) );
+        __asm__ __volatile__( "mrs %0, cntfrq_el0" : "=r" (freq) );
+        if (freq)
+        {
+            counter->QuadPart = (ULONGLONG)((unsigned __int128)ticks * TICKSPERSEC / freq) + user_shared_data->QpcBias;
+            return TRUE;
+        }
+    }
+#endif
     NtQueryPerformanceCounter( counter, NULL );
     return TRUE;
 }
