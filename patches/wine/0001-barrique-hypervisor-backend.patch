+    struct vkd3d_pso_hint *hint;
+    unsigned int i;
+
+    if (!device->pso_hints)
+    {
+        if (!insert || !(device->pso_hints = vkd3d_calloc(VKD3D_PSO_HINT_COUNT, sizeof(*device->pso_hints))))
+            return NULL;
+    }
+
+    for (i = 0; i < VKD3D_PSO_HINT_PROBES; ++i)
+    {
+        hint = &device->pso_hints[(hash + i) & (VKD3D_PSO_HINT_COUNT - 1)];
+        if (hint->hash == hash)
+            return hint;
+        if (!hint->hash)
+            return insert ? hint : NULL;
+    }
+    /* full: replace the first probe */
+    return insert ? &device->pso_hints[hash & (VKD3D_PSO_HINT_COUNT - 1)] : NULL;
+}
