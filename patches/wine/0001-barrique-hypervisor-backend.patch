+static HRESULT STDMETHODCALLTYPE device_CreateTargetForHwnd(IDCompositionDevice *iface, HWND hwnd, BOOL topmost,
+        IDCompositionTarget **out)
+{
+    struct composition_device *device = impl_from_IDCompositionDevice(iface);
+    struct composition_target *target;
+
+    TRACE("iface %p, hwnd %p, topmost %d, out %p.\n", iface, hwnd, topmost, out);
+
+    if (!out) return E_INVALIDARG;
+    *out = NULL;
+    if (!IsWindow(hwnd)) return E_INVALIDARG;
+    if (!(target = calloc(1, sizeof(*target)))) return E_OUTOFMEMORY;
+    /* the target shows our child window now; as a layered window (Chromium's
+     * "Intermediate D3D Window") it would show nothing drawn with GDI */
+    if (GetWindowLongW(hwnd, GWL_EXSTYLE) & WS_EX_LAYERED)
+        SetWindowLongW(hwnd, GWL_EXSTYLE, GetWindowLongW(hwnd, GWL_EXSTYLE) & ~WS_EX_LAYERED);
+    target->IDCompositionTarget_iface.lpVtbl = &target_vtbl;
+    target->refcount = 1;
+    target->hwnd = hwnd;
+    target->device = device;
+    IDCompositionDevice_AddRef(iface);
+    EnterCriticalSection(&device->cs);
+    list_add_tail(&device->targets, &target->entry);
+    LeaveCriticalSection(&device->cs);
+    *out = &target->IDCompositionTarget_iface;
+    return S_OK;
+}
