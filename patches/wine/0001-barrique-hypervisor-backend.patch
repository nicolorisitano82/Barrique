diff --git a/dlls/kernelbase/process.c b/dlls/kernelbase/process.c
index c58e977..7e49a5a 100644
--- a/dlls/kernelbase/process.c
+++ b/dlls/kernelbase/process.c
@@ -916,6 +916,15 @@ BOOL WINAPI /* DECLSPEC_HOTPATCH */ GetProcessMitigationPolicy( HANDLE process,
                                                           void *buffer, SIZE_T length )
 {
     FIXME( "(%p, %u, %p, %Iu): stub\n", process, policy, buffer, length );
+    if (!buffer || !length || policy >= MaxProcessMitigationPolicy)
+    {
+        SetLastError( ERROR_INVALID_PARAMETER );
+        return FALSE;
+    }
+    /* Wine enforces none of the policies: report them all off. Leaving the buffer
+     * untouched made Firefox's GPU process read stack garbage as
+     * DisallowWin32kSystemCalls and abort (MOZ_RELEASE_ASSERT(!IsWin32kLockedDown())). */
+    memset( buffer, 0, length );
     return TRUE;
 }
 
