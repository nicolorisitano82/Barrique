+        return;
+
+    vkd3d_mutex_lock(&device->pipeline_cache_mutex);
+    if ((hint = pso_hint_slot(device, graphics->layout_hash, false)))
+    {
+        topology = hint->topology;
+        memcpy(strides, hint->strides, sizeof(strides));
+    }
+    vkd3d_mutex_unlock(&device->pipeline_cache_mutex);
+
+    if (!topology)
