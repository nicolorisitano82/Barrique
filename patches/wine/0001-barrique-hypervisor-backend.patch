+/* Barrique (Hypervisor.framework): above 4GB Windows addresses are host addresses,
+ * and arm64 executables are always PIE, so no zerofill section can keep the host
+ * out of the range where x64 executables without relocations are linked
+ * (0x140000000). Reserve what is still free of it before anything else runs;
+ * ntdll marks it as reserved areas. Up to 0x180000000, where the dyld shared
+ * cache starts. */
+static struct wine_preload_info preload_info[9];
+
+/* Zero-fill space right after the loader image, so that the kernel lays it out over
+ * 0x140000000 (the loader is mapped just above the 4GB page zero) and nothing else
+ * can land there before main() runs; init_reserved_areas() hands it to ntdll. */
+static char wine_exe_reserve[0x7c000000] __attribute__((aligned(0x4000)));
+
+const __attribute((visibility("default"))) struct wine_preload_info *wine_main_preload_info = preload_info;
+
+static void init_reserved_areas(void)
+{
+    mach_vm_address_t address = 0x140000000, end = 0x180000000;
+    mach_vm_address_t resv = (mach_vm_address_t)wine_exe_reserve;
+    mach_vm_address_t resv_end = resv + sizeof(wine_exe_reserve);
+    unsigned int count = 0;
+
+    /* give the zero-fill space back as reserved address space */
+    if (resv < 0x100000000) resv = 0x100000000;
+    if (resv < resv_end && !mach_vm_map( mach_task_self(), &resv, resv_end - resv, 0,
+                                         VM_FLAGS_FIXED | VM_FLAGS_OVERWRITE, MEMORY_OBJECT_NULL, 0, 0,
+                                         VM_PROT_NONE, VM_PROT_ALL, VM_INHERIT_COPY ))
+    {
+        preload_info[count].addr = (void *)resv;
+        preload_info[count].size = resv_end - resv;
+        count++;
+        if (address < resv_end && resv <= address) address = resv_end;
+    }
+
+    /* ntdll wants reserved areas on the 64K allocation granularity */
+    for (unsigned int i = 0; i < count; i++)
+    {
+        mach_vm_address_t start = ((mach_vm_address_t)preload_info[i].addr + 0xffff) & ~0xffffULL;
+        mach_vm_address_t stop = ((mach_vm_address_t)preload_info[i].addr + preload_info[i].size) & ~0xffffULL;
+        preload_info[i].addr = (void *)start;
+        preload_info[i].size = stop > start ? stop - start : 0;
+    }
+    while (address < end && count < sizeof(preload_info) / sizeof(preload_info[0]) - 1)
+    {
+        mach_vm_address_t region = address, hole = address;
+        mach_vm_size_t size = 0;
+        vm_region_basic_info_data_64_t info;
+        mach_msg_type_number_t info_count = VM_REGION_BASIC_INFO_COUNT_64;
+        mach_port_t object = MACH_PORT_NULL;
+
+        if (mach_vm_region( mach_task_self(), &region, &size, VM_REGION_BASIC_INFO_64,
+                            (vm_region_info_t)&info, &info_count, &object ) != KERN_SUCCESS)
+            region = end;
+        if (region > end) region = end;
+        hole = (hole + 0xffff) & ~0xffffULL;
+        if (region > hole && (region - hole) >= 0x10000)
+        {
+            mach_vm_size_t len = (region - hole) & ~0xffffULL;
+            if (!mach_vm_map( mach_task_self(), &hole, len, 0, VM_FLAGS_FIXED, MEMORY_OBJECT_NULL,
+                              0, 0, VM_PROT_NONE, VM_PROT_ALL, VM_INHERIT_COPY ))
+            {
+                preload_info[count].addr = (void *)hole;
+                preload_info[count].size = len;
+                count++;
+            }
+        }
