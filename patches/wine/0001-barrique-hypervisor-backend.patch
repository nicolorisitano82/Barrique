+/* the window Wine's dxgi made for a composition swapchain, if content is one */
+static HWND content_window(IUnknown *content)
+{
+    IDXGIObject *object;
+    UINT size = sizeof(HWND);
+    HWND hwnd = NULL;
+
+    if (!content || FAILED(IUnknown_QueryInterface(content, &IID_IDXGIObject, (void **)&object))) return NULL;
+    if (FAILED(IDXGIObject_GetPrivateData(object, &WINE_DXGI_COMPOSITION_HWND, &size, &hwnd)) || size != sizeof(hwnd))
+        hwnd = NULL;
+    IDXGIObject_Release(object);
+    return hwnd;
+}
+
+static void commit_target(struct composition_target *target)
+{
+    HWND hwnd = target->root ? content_window(target->root->content) : NULL;
+    RECT rect;
+
+    if (target->root && target->root->content && !hwnd)
+        FIXME("Content %p of target %p is no composition swapchain, not shown.\n", target->root->content, target);
+
+    if (target->shown && target->shown != hwnd && IsWindow(target->shown))
+        ShowWindow(target->shown, SW_HIDE);
+    target->shown = hwnd;
+    if (!hwnd || !IsWindow(hwnd)) return;
+
+    if (GetAncestor(hwnd, GA_PARENT) != target->hwnd)
+    {
+        TRACE("Placing swapchain window %p in %p.\n", hwnd, target->hwnd);
+        SetWindowLongW(hwnd, GWL_STYLE, WS_CHILD | WS_CLIPSIBLINGS | WS_DISABLED);
+        SetParent(hwnd, target->hwnd);
+    }
+    GetClientRect(target->hwnd, &rect);
+    SetWindowPos(hwnd, HWND_TOP, 0, 0, rect.right, rect.bottom, SWP_NOACTIVATE | SWP_SHOWWINDOW);
+}
+
+static HRESULT STDMETHODCALLTYPE device_Commit(IDCompositionDevice *iface)
+{
+    struct composition_device *device = impl_from_IDCompositionDevice(iface);
+    struct composition_target *target;
+
+    TRACE("iface %p.\n", iface);
+
+    EnterCriticalSection(&device->cs);
+    LIST_FOR_EACH_ENTRY(target, &device->targets, struct composition_target, entry)
+        commit_target(target);
+    LeaveCriticalSection(&device->cs);
+    return S_OK;
+}
