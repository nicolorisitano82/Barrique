diff --git a/dlls/mfsrcsnk/media_source.c b/dlls/mfsrcsnk/media_source.c
index ec87be6..8932d17 100644
--- a/dlls/mfsrcsnk/media_source.c
+++ b/dlls/mfsrcsnk/media_source.c
@@ -2167,3 +2167,34 @@ static const IClassFactoryVtbl mp3_byte_stream_plugin_factory_vtbl =
 };
 
 IClassFactory mp3_byte_stream_plugin_factory = {&mp3_byte_stream_plugin_factory_vtbl};
+
+/* Barrique: MPEG-1/2 program and transport streams (.mpg, .vob, .ts), which
+ * upstream Media Foundation has no handler for; FFmpeg probes either */
+static HRESULT WINAPI mpeg_byte_stream_plugin_factory_CreateInstance(IClassFactory *iface,
+        IUnknown *outer, REFIID riid, void **out)
+{
+    NTSTATUS status;
+
+    /* Barrique: always the winedmo demuxer and the Media Foundation decoders
+     * (msmpeg2vdec, mp3dmod) when FFmpeg is there, like Windows; the GStreamer
+     * handler's own decodebin fails on MP2 audio (avdec_mp2 without a parser) */
+    if ((status = winedmo_demuxer_check("video/mpeg")))
+    {
+        static const GUID CLSID_GStreamerByteStreamHandler = {0x317df618,0x5e5a,0x468a,{0x9f,0x15,0xd8,0x27,0xa9,0xa0,0x81,0x62}};
