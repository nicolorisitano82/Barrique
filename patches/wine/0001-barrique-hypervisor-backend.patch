+/* Barrique debugging aid: VKD3D_BARRIQUE_RT_DUMP=<windows path of a trigger file>.
+ * Once that file exists, render target 0 of every render pass recorded afterwards
+ * (scene-sized 2D targets only, at most RT_DUMP_MAX) is copied to a readback buffer;
+ * dumps are numbered in ExecuteCommandLists order and written as raw texels to
+ * C:\\vkrtdump\\<seq>_<width>x<height>_f<dxgi format>_<resource>.raw some frames later. */
+#define RT_DUMP_MAX 90
+static int rt_dump_state = -1;  /* -1 unknown, 0 waiting for the trigger, 1 dumping, 2 writing, 3 done */
+static const char *rt_dump_trigger;
+static LONG rt_dump_recorded, rt_dump_seq, rt_dump_executes;
+static struct vkd3d_rt_dump rt_dump_pending[RT_DUMP_MAX];
+static unsigned int rt_dump_pending_count;
+static struct vkd3d_mutex rt_dump_mutex;
+
+static void d3d12_command_list_dump_rt(struct d3d12_command_list *list, struct d3d12_resource *resource)
+{
+    const struct vkd3d_vk_device_procs *vk_procs = &list->device->vk_procs;
+    D3D12_HEAP_PROPERTIES heap_properties = {D3D12_HEAP_TYPE_READBACK};
+    D3D12_RESOURCE_DESC1 buffer_desc = {0};
+    struct vkd3d_rt_dump *dump;
+    VkBufferImageCopy region;
+    VkImageMemoryBarrier barrier;
+    VkImageAspectFlags aspect;
+    VkDeviceSize size;
+
+    if (rt_dump_state != 1 || !resource || resource->desc.Dimension != D3D12_RESOURCE_DIMENSION_TEXTURE2D
+            || resource->desc.Width < 1024
+            || resource->desc.SampleDesc.Count != 1 || !resource->format || resource->format->block_width > 1)
+        return;
+    aspect = resource->format->vk_aspect_mask & VK_IMAGE_ASPECT_DEPTH_BIT ? VK_IMAGE_ASPECT_DEPTH_BIT
+            : resource->format->vk_aspect_mask == VK_IMAGE_ASPECT_COLOR_BIT ? VK_IMAGE_ASPECT_COLOR_BIT : 0;
+    if (!aspect)
+        return;
+    if (InterlockedIncrement(&rt_dump_recorded) > RT_DUMP_MAX)
+        return;
+    if (!vkd3d_array_reserve((void **)&list->rt_dumps, &list->rt_dumps_size,
+            list->rt_dump_count + 1, sizeof(*list->rt_dumps)))
+        return;
+    dump = &list->rt_dumps[list->rt_dump_count];
+    memset(dump, 0, sizeof(*dump));
+    dump->width = resource->desc.Width;
+    dump->height = resource->desc.Height;
+    dump->byte_count = aspect == VK_IMAGE_ASPECT_DEPTH_BIT ? 4 : resource->format->byte_count;
+    dump->format = aspect == VK_IMAGE_ASPECT_DEPTH_BIT ? 999 : resource->format->dxgi_format;
+    dump->resource = resource;
+    size = (VkDeviceSize)dump->width * dump->height * dump->byte_count;
+
+    buffer_desc.Dimension = D3D12_RESOURCE_DIMENSION_BUFFER;
+    buffer_desc.Width = size;
+    buffer_desc.Height = 1;
+    buffer_desc.DepthOrArraySize = 1;
+    buffer_desc.MipLevels = 1;
+    buffer_desc.SampleDesc.Count = 1;
+    buffer_desc.Layout = D3D12_TEXTURE_LAYOUT_ROW_MAJOR;
+    if (FAILED(vkd3d_create_buffer(list->device, &heap_properties, D3D12_HEAP_FLAG_NONE, &buffer_desc, &dump->buffer)))
+        return;
+    if (FAILED(vkd3d_allocate_buffer_memory(list->device, dump->buffer, &heap_properties,
+            D3D12_HEAP_FLAG_NONE, &dump->memory, NULL, NULL)))
+    {
+        VK_CALL(vkDestroyBuffer(list->device->vk_device, dump->buffer, NULL));
+        return;
+    }
+
+    barrier.sType = VK_STRUCTURE_TYPE_IMAGE_MEMORY_BARRIER;
+    barrier.pNext = NULL;
+    barrier.srcAccessMask = VK_ACCESS_COLOR_ATTACHMENT_WRITE_BIT | VK_ACCESS_DEPTH_STENCIL_ATTACHMENT_WRITE_BIT;
+    barrier.dstAccessMask = VK_ACCESS_TRANSFER_READ_BIT;
+    barrier.oldLayout = VK_IMAGE_LAYOUT_GENERAL;
+    barrier.newLayout = VK_IMAGE_LAYOUT_GENERAL;
+    barrier.srcQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED;
+    barrier.dstQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED;
+    barrier.image = resource->u.vk_image;
+    barrier.subresourceRange.aspectMask = resource->format->vk_aspect_mask;
+    barrier.subresourceRange.baseMipLevel = 0;
+    barrier.subresourceRange.levelCount = 1;
+    barrier.subresourceRange.baseArrayLayer = 0;
+    barrier.subresourceRange.layerCount = 1;
+    VK_CALL(vkCmdPipelineBarrier(list->vk_command_buffer, VK_PIPELINE_STAGE_ALL_COMMANDS_BIT,
+            VK_PIPELINE_STAGE_TRANSFER_BIT, 0, 0, NULL, 0, NULL, 1, &barrier));
+
+    memset(&region, 0, sizeof(region));
+    region.imageSubresource.aspectMask = aspect;
+    region.imageSubresource.layerCount = 1;
+    region.imageExtent.width = dump->width;
+    region.imageExtent.height = dump->height;
+    region.imageExtent.depth = 1;
+    ++list->timing_other;
+    VK_CALL(vkCmdCopyImageToBuffer(list->vk_command_buffer, resource->u.vk_image,
+            VK_IMAGE_LAYOUT_GENERAL, dump->buffer, 1, &region));
+
+    barrier.srcAccessMask = VK_ACCESS_TRANSFER_READ_BIT;
+    barrier.dstAccessMask = VK_ACCESS_COLOR_ATTACHMENT_WRITE_BIT | VK_ACCESS_SHADER_READ_BIT;
+    VK_CALL(vkCmdPipelineBarrier(list->vk_command_buffer, VK_PIPELINE_STAGE_TRANSFER_BIT,
+            VK_PIPELINE_STAGE_ALL_COMMANDS_BIT, 0, 0, NULL, 0, NULL, 1, &barrier));
+    ++list->rt_dump_count;
+}
+
+static void rt_dump_execute(struct d3d12_device *device, struct d3d12_command_list *list)
+{
+    const struct vkd3d_vk_device_procs *vk_procs = &device->vk_procs;
+    unsigned int i;
+
+    if (rt_dump_state < 0)
+    {
+        rt_dump_trigger = getenv("VKD3D_BARRIQUE_RT_DUMP");
+        rt_dump_state = rt_dump_trigger ? 0 : 3;
+        if (rt_dump_trigger)
+            vkd3d_mutex_init(&rt_dump_mutex);
+    }
+    if (rt_dump_state == 3)
+        return;
+    vkd3d_mutex_lock(&rt_dump_mutex);
+    if (rt_dump_state == 0 && GetFileAttributesA(rt_dump_trigger) != INVALID_FILE_ATTRIBUTES)
+    {
+        ERR("Dumping render targets.\n");
+        rt_dump_state = 1;
+    }
+    if (list)
+    {
+        for (i = 0; i < list->rt_dump_count && rt_dump_pending_count < RT_DUMP_MAX; ++i)
+        {
+            list->rt_dumps[i].seq = ++rt_dump_seq;
+            rt_dump_pending[rt_dump_pending_count++] = list->rt_dumps[i];
+        }
+        list->rt_dump_count = 0;
+    }
+    if (rt_dump_state == 1 && rt_dump_recorded >= RT_DUMP_MAX)
+        rt_dump_state = 2;
+    if (rt_dump_state == 2 && ++rt_dump_executes > 200)
+    {
+        VK_CALL(vkDeviceWaitIdle(device->vk_device));
+        CreateDirectoryA("C:\\vkrtdump", NULL);
+        for (i = 0; i < rt_dump_pending_count; ++i)
+        {
+            struct vkd3d_rt_dump *dump = &rt_dump_pending[i];
+            char name[128];
+            void *data;
+            FILE *f;
+
+            sprintf(name, "C:\\vkrtdump\\%04u_%ux%u_f%u_%p.raw", dump->seq, dump->width,
+                    dump->height, dump->format, dump->resource);
+            if (VK_CALL(vkMapMemory(device->vk_device, dump->memory, 0, VK_WHOLE_SIZE, 0, &data)) >= 0)
+            {
+                if ((f = fopen(name, "wb")))
+                {
+                    fwrite(data, 1, (size_t)dump->width * dump->height * dump->byte_count, f);
+                    fclose(f);
+                }
+                VK_CALL(vkUnmapMemory(device->vk_device, dump->memory));
+            }
+            VK_CALL(vkDestroyBuffer(device->vk_device, dump->buffer, NULL));
+            VK_CALL(vkFreeMemory(device->vk_device, dump->memory, NULL));
+        }
+        ERR("Wrote %u render target dumps.\n", rt_dump_pending_count);
+        rt_dump_state = 3;
+    }
+    vkd3d_mutex_unlock(&rt_dump_mutex);
+}
