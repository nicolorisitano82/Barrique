+BOOL hvf_copy;
+
+static pthread_mutex_t hvf_string_lock = PTHREAD_MUTEX_INITIALIZER;
+static struct hvf_string
+{
+    struct hvf_string *next;
+    size_t len;
+    char *copy;
+} *hvf_strings;
+static char *hvf_string_pool;
+static SIZE_T hvf_string_left;
+
+/* Return a copy of a driver string in memory that Windows code can read. Driver
+ * strings live as long as the context and repeat, so copies are kept and shared. */
+const void *hvf_string( const void *str )
+{
+    struct hvf_string *entry;
+    const char *ret = NULL;
+    size_t len;
+
+    if (!str) return NULL;
+    len = strlen( str ) + 1;
+
+    pthread_mutex_lock( &hvf_string_lock );
+    for (entry = hvf_strings; entry; entry = entry->next)
+        if (entry->len == len && !memcmp( entry->copy, str, len )) break;
+    if (entry)
+    {
+        ret = entry->copy;
+        goto done;
+    }
+    if (len > hvf_string_left)
+    {
+        SIZE_T size = (len + 0xffff) & ~(SIZE_T)0xffff;
+        void *pool = NULL;
+
+        if (NtAllocateVirtualMemory( GetCurrentProcess(), &pool, 0, &size, MEM_COMMIT, PAGE_READWRITE ))
+        {
+            ERR( "NtAllocateVirtualMemory failed\n" );
+            goto done;
+        }
+        hvf_string_pool = pool;
+        hvf_string_left = size;
+    }
+    if (!(entry = malloc( sizeof(*entry) ))) goto done;
+    entry->len = len;
+    entry->copy = hvf_string_pool;
+    memcpy( entry->copy, str, len );
+    hvf_string_pool += len;
+    hvf_string_left -= len;
+    entry->next = hvf_strings;
+    hvf_strings = entry;
+    ret = entry->copy;
+done:
+    pthread_mutex_unlock( &hvf_string_lock );
+    return ret;
+}
+
+void hvf_glGetBufferPointerv( TEB *teb, GLenum target, GLenum pname, void **params,
+                              PFN_glGetBufferPointerv p_glGetBufferPointerv )
+{
+    struct buffer *buffer;
+
+    if (pname == GL_BUFFER_MAP_POINTER && (buffer = get_target_buffer_storage( teb, target )))
+    {
+        *params = buffer->map_ptr;
+        return;
+    }
+    p_glGetBufferPointerv( target, pname, params );
+}
+
+void hvf_glGetNamedBufferPointerv( TEB *teb, GLuint name, GLenum pname, void **params,
+                                   PFN_glGetNamedBufferPointerv p_glGetNamedBufferPointerv )
+{
+    struct buffer *buffer;
+
+    if (pname == GL_BUFFER_MAP_POINTER && name && (buffer = get_named_buffer_storage( teb, name )))
+    {
+        *params = buffer->map_ptr;
+        return;
+    }
+    p_glGetNamedBufferPointerv( name, pname, params );
+}
