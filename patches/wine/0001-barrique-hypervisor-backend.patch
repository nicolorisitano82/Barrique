+/***********************************************************************
+ *              macdrv_functions
+ *
+ * Barrique: the driver table DXMT's winemetal.so looks up with dlsym (the
+ * layout CrossOver's winemac.drv exports), so DXMT's D3D11 can draw into a
+ * window. DXMT reads struct macdrv_win_data with the Wine 8 layout (hwnd,
+ * cocoa_window, cocoa_view, client_cocoa_view); Wine 11 has neither of the last
+ * two, so get_win_data hands out a compatible copy whose client view is the view
+ * of a client surface, the same kind Vulkan and OpenGL use, which win32u keeps
+ * over the window's client area. The surface lives until DXMT releases the
+ * Metal view it created in it.
+ */
+struct dxmt_win_data
+{
+    HWND                          hwnd;
+    WineWindow                   *cocoa_window;
+    WineContentView              *cocoa_view;
+    WineContentView              *client_cocoa_view;
+    /* private */
+    struct macdrv_win_data       *data;
+    struct client_surface        *surface;
+};
+
+struct dxmt_metal_view
+{
+    struct list            entry;
+    WineMetalView         *view;
+    struct client_surface *surface;
+};
+
+static struct list dxmt_metal_views = LIST_INIT(dxmt_metal_views);
+static pthread_mutex_t dxmt_lock = PTHREAD_MUTEX_INITIALIZER;
+static __thread struct client_surface *dxmt_pending_surface;
+
+static struct dxmt_win_data *dxmt_get_win_data(HWND hwnd)
+{
+    struct macdrv_client_surface *impl;
+    struct client_surface *surface;
+    struct dxmt_win_data *ret;
+
+    if (!(surface = macdrv_CreateClientSurface(hwnd, 0, FALSE))) return NULL;
+    impl = impl_from_client_surface(surface);
+    if (!(ret = calloc(1, sizeof(*ret))) || !(ret->data = get_win_data(hwnd)))
+    {
+        free(ret);
+        client_surface_release(surface);
+        return NULL;
+    }
+    ret->hwnd = hwnd;
+    ret->cocoa_window = ret->data->cocoa_window;
+    ret->cocoa_view = impl->cocoa_view;
+    ret->client_cocoa_view = impl->cocoa_view;
+    ret->surface = surface;
+    dxmt_pending_surface = surface;
+    TRACE("hwnd %p -> client view %p\n", hwnd, impl->cocoa_view);
+    return ret;
+}
+
+static void dxmt_release_win_data(struct dxmt_win_data *data)
+{
+    if (!data) return;
+    release_win_data(data->data);
+    /* no Metal view was created in it: nobody needs the surface */
+    if (dxmt_pending_surface == data->surface)
+    {
+        dxmt_pending_surface = NULL;
+        client_surface_release(data->surface);
+    }
+    free(data);
+}
+
+static WineMetalView *dxmt_view_create_metal_view(WineContentView *view, MTLDevice_id device)
+{
+    struct dxmt_metal_view *entry;
+    WineMetalView *metal_view;
+
+    if (!(metal_view = macdrv_view_create_metal_view(view, device))) return NULL;
+    if (dxmt_pending_surface && (entry = calloc(1, sizeof(*entry))))
+    {
+        entry->view = metal_view;
+        entry->surface = dxmt_pending_surface;
+        dxmt_pending_surface = NULL;
+        pthread_mutex_lock(&dxmt_lock);
+        list_add_tail(&dxmt_metal_views, &entry->entry);
+        pthread_mutex_unlock(&dxmt_lock);
+    }
+    return metal_view;
+}
+
+static void dxmt_view_release_metal_view(WineMetalView *view)
+{
+    struct dxmt_metal_view *entry, *found = NULL;
+
+    pthread_mutex_lock(&dxmt_lock);
+    LIST_FOR_EACH_ENTRY(entry, &dxmt_metal_views, struct dxmt_metal_view, entry)
+    {
+        if (entry->view != view) continue;
+        list_remove(&entry->entry);
+        found = entry;
+        break;
+    }
+    pthread_mutex_unlock(&dxmt_lock);
+
+    macdrv_view_release_metal_view(view);
+    if (found)
+    {
+        client_surface_release(found->surface);
+        free(found);
+    }
+}
+
+static WineWindow *dxmt_get_cocoa_window(HWND hwnd, BOOL require_on_screen)
+{
+    return macdrv_get_cocoa_window(hwnd, require_on_screen);
+}
+
+struct macdrv_functions_t
+{
+    void (*macdrv_init_display_devices)(BOOL);
+    struct dxmt_win_data *(*get_win_data)(HWND hwnd);
+    void (*release_win_data)(struct dxmt_win_data *data);
+    WineWindow *(*macdrv_get_cocoa_window)(HWND hwnd, BOOL require_on_screen);
+    MTLDevice_id (*macdrv_create_metal_device)(void);
+    void (*macdrv_release_metal_device)(MTLDevice_id d);
+    WineMetalView *(*macdrv_view_create_metal_view)(WineContentView *v, MTLDevice_id d);
+    CAMetalLayer *(*macdrv_view_get_metal_layer)(WineMetalView *v);
+    void (*macdrv_view_release_metal_view)(WineMetalView *v);
+    void (*on_main_thread)(void *block);
+};
+
+__attribute__((visibility("default"))) struct macdrv_functions_t macdrv_functions =
+{
+    NULL,
+    dxmt_get_win_data,
+    dxmt_release_win_data,
+    dxmt_get_cocoa_window,
+    macdrv_create_metal_device,
+    macdrv_release_metal_device,
+    dxmt_view_create_metal_view,
+    macdrv_view_get_metal_layer,
+    dxmt_view_release_metal_view,
+    NULL,
+};
+
+
+/***********************************************************************
+ * Barrique: memory for DXMT's Metal buffers (see cocoa_dxmt.m).
+ *
+ * The buffers winemetal.so creates with newBufferWithLength are handed to the
+ * Windows side, which in the VM can only touch Windows memory. cocoa_dxmt.m
+ * gives Metal process memory allocated here as a Windows view instead
+ * (newBufferWithBytesNoCopy). Metal may drop a buffer on a thread Wine did not
+ * create, so frees are queued and done on the next allocation.
+ */
+static pthread_mutex_t dxmt_free_lock = PTHREAD_MUTEX_INITIALIZER;
+static struct dxmt_free { struct dxmt_free *next; void *addr; } *dxmt_free_list;
+
+static void dxmt_drain_frees(void)
+{
+    struct dxmt_free *list, *next;
+    SIZE_T size;
+
+    pthread_mutex_lock(&dxmt_free_lock);
+    list = dxmt_free_list;
+    dxmt_free_list = NULL;
+    pthread_mutex_unlock(&dxmt_free_lock);
+
+    for (; list; list = next)
+    {
+        next = list->next;
+        size = 0;
+        NtFreeVirtualMemory(GetCurrentProcess(), &list->addr, &size, MEM_RELEASE);
+        free(list);
+    }
+}
+
+/* returns the host address of size bytes of Windows memory, or NULL */
+void *macdrv_dxmt_alloc(size_t size, void **windows_addr)
+{
+    void *addr = NULL;
+    SIZE_T alloc_size = size;
+
+    dxmt_drain_frees();
+    if (NtAllocateVirtualMemory(GetCurrentProcess(), &addr, 0, &alloc_size, MEM_COMMIT | MEM_RESERVE, PAGE_READWRITE))
+        return NULL;
+    *windows_addr = addr;
+    return wine_low_window_ptr((ULONG_PTR)addr);
+}
+
+/* any thread, also one Wine did not create */
+void macdrv_dxmt_free(void *windows_addr)
+{
+    struct dxmt_free *entry = malloc(sizeof(*entry));
+
+    if (!entry) return;  /* leak rather than crash */
+    entry->addr = windows_addr;
+    pthread_mutex_lock(&dxmt_free_lock);
+    entry->next = dxmt_free_list;
+    dxmt_free_list = entry;
+    pthread_mutex_unlock(&dxmt_free_lock);
+}
