+#ifdef __APPLE__
+    /* Barrique: USB serial adapters (FTDI, CP210x, CH34x, CDC ACM) show up as
+     * /dev/cu.<name>; give each one a COM port, sorted so the numbering is stable
+     * for the same set of devices. */
+    {
