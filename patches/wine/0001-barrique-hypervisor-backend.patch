+/* Barrique: MoltenVK gives a swapchain image back only once macOS reports its
+ * drawable as shown (addPresentedHandler), which a hidden or minimized window may
+ * never do (same with an empty client area), so the next vkAcquireNextImageKHR or
+ * the wait on its fence blocked forever. On Windows presenting to such a window
+ * completes at once. When every window of the present is hidden, minimized or has
+ * an empty client area, wait for the semaphores with an empty submit and give the
+ * images back with vkReleaseSwapchainImagesEXT (VK_EXT_swapchain_maintenance1)
+ * instead of presenting them. Presents with a pNext chain take the normal path. */
+static BOOL present_to_hidden_windows( struct vulkan_device *device, struct vulkan_queue *queue,
+                                       VkPresentInfoKHR *present_info, const VkSwapchainKHR *client_swapchains )
+{
+    VkPipelineStageFlags stages[16];
+    VkSubmitInfo submit = {.sType = VK_STRUCTURE_TYPE_SUBMIT_INFO};
+    uint32_t i;
+
+    if (!device->p_vkReleaseSwapchainImagesEXT || present_info->pNext || !present_info->swapchainCount) return FALSE;
+    if (present_info->waitSemaphoreCount > ARRAY_SIZE(stages)) return FALSE;
+
+    for (i = 0; i < present_info->swapchainCount; i++)
+    {
+        struct swapchain *swapchain = swapchain_from_handle( client_swapchains[i] );
+        HWND hwnd = swapchain->surface->hwnd;
+        RECT rect;
+
+        if (is_window_visible( hwnd ) && !is_iconic( NtUserGetAncestor( hwnd, GA_ROOT ) ) &&
+            get_surface_rect( hwnd, &rect, get_dpi_for_window( hwnd ) ) && !IsRectEmpty( &rect ))
+            return FALSE;
+    }
