+
+static void d3d11_swapchain_copy_to_composition_window(struct d3d11_swapchain *swapchain,
+        const DXGI_PRESENT_PARAMETERS *params)
+{
+    ID3D11Texture2D *buffer, *staging = swapchain->composition_staging;
+    D3D11_TEXTURE2D_DESC desc, staging_desc;
+    D3D11_MAPPED_SUBRESOURCE map;
+    ID3D11DeviceContext *context;
