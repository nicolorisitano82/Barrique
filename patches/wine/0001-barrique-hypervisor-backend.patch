+
+/* Barrique: BARRIQUE_VK_STATS=1 prints the batched commands per second, per kind */
+static LONG *batch_stats;
+static LONG batch_stats_last[4096];
+
+static void print_batch_stats(void)
+{
+#ifdef _WIN64
+    extern const unixlib_entry_t __wine_unix_call_funcs[];
+    static ULONGLONG last_time;
+    static LONG printing;
+    ULONGLONG now = NtGetTickCount();
+    unsigned int i;
+
+    if (now - last_time < 5000 || InterlockedExchange(&printing, 1)) return;
+    if (now - last_time >= 5000)
+    {
+        last_time = now;
+        for (i = 0; i < unix_count && i < 4096; i++)
+        {
+            LONG d = batch_stats[i] - batch_stats_last[i];
+            Dl_info info;
+            batch_stats_last[i] = batch_stats[i];
+            if (d / 5 && dladdr(__wine_unix_call_funcs[i], &info) && info.dli_sname)
+                fprintf(stderr, "vk stats %04x: %s %d/s\n", (int)GetCurrentProcessId(), info.dli_sname, (int)d / 5);
+        }
+    }
+    printing = 0;
+#endif
+}
