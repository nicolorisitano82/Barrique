+#if defined(__APPLE__) && defined(__aarch64__)
+/* Barrique: debugging aid, wineserver SIGHUP (kill -HUP <wineserver pid>): write
+ * waits-<time>.txt in the server directory with every thread, whether it is waiting
+ * in the server and on which objects (type, name, signaled). Changes nothing; meant
+ * for hangs that disappear under +server or +sync tracing. */
+void dump_thread_waits(void)
+{
+    char path[64];
+    struct thread *thread;
+    int fd, saved;
+
+    snprintf( path, sizeof(path), "waits-%ld.txt", (long)time( NULL ) );
+    if ((fd = open( path, O_WRONLY | O_CREAT | O_TRUNC, 0600 )) == -1) return;
+    fflush( stderr );
+    saved = dup( 2 );
+    dup2( fd, 2 );
+    close( fd );
+
+    LIST_FOR_EACH_ENTRY( thread, &thread_list, struct thread, entry )
+    {
+        struct thread_wait *wait = thread->wait;
+        struct process *process = thread->process;
+        int i;
+
+        fprintf( stderr, "pid %04x tid %04x unix %d/%d ", process->id, thread->id, thread->unix_pid, thread->unix_tid );
+        if (process->image)
+        {
+            data_size_t len = process->imagelen / sizeof(WCHAR), start = len;
+            while (start && process->image[start - 1] != '\\') start--;
+            for (; start < len; start++) fputc( process->image[start] < 0x80 ? process->image[start] : '?', stderr );
+        }
+        if (thread->state == TERMINATED) { fprintf( stderr, " terminated, exit code %#x\n", thread->exit_code ); continue; }
+        if (!wait) { fprintf( stderr, " not waiting in the server\n" ); continue; }
+        fprintf( stderr, " waiting: %s, %d object(s), flags %#x%s\n",
+                 wait->select == SELECT_WAIT_ALL ? "all" : "any", wait->count, wait->flags,
+                 wait->user ? ", with timeout" : "" );
+        for (i = 0; i < wait->count; i++)
+        {
+            struct object *obj = wait->queues[i].obj;
+            fprintf( stderr, "    [%d] %s ", i, object_sync_signaled( obj, &wait->queues[i] ) ? "SIGNALED" : "-" );
+            dump_object_name( obj );
+            obj->ops->dump( obj, 0 );
+        }
+    }
+    fflush( stderr );
+    dup2( saved, 2 );
+    close( saved );
+}
+#endif
