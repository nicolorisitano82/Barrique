+        if ((dir = opendir( "/dev" )))
+        {
+            while (count < ARRAY_SIZE(found) && (de = readdir( dir )))
+                for (i = 0; prefixes[i]; i++)
+                    if (!strncmp( de->d_name, prefixes[i], strlen( prefixes[i] )))
+                    {
+                        if (asprintf( &found[count], "/dev/%s", de->d_name ) != -1) count++;
+                        break;
+                    }
+            closedir( dir );
+        }
+        for (i = 1; i < count; i++)
+            for (j = i; j && strcmp( found[j - 1], found[j] ) > 0; j--)
+            {
+                char *tmp = found[j]; found[j] = found[j - 1]; found[j - 1] = tmp;
+            }
+        for (i = 0; i < count; i++)
+        {
+            ULONG len = strlen( found[i] ) + 1;
+            if (len + 1 <= size)
+            {
+                strcpy( names, found[i] );
+                names += len;
+                size -= len;
+            }
+            free( found[i] );
