+    }
+    allocator->command_buffers[allocator->command_buffer_count++] = vk_buffer;
+    return list->vk_init_command_buffer = vk_buffer;
+}
+
+/* Barrique: VKD3D_BARRIQUE_GPU_TIMING=1 measures GPU time per render pass with
+ * timestamps. MoltenVK on Apple GPUs samples a timestamp at the end of the Metal
+ * encoder it is recorded in, so one is written at the end of each render pass
+ * and one at the end of the compute/copy work before a render pass; the time
+ * between two consecutive timestamps is charged to the later one. */
+struct vkd3d_timing_label
+{
+    unsigned int kind; /* 0 render pass, 1 compute/copy, 2 first of a recording, 3 dispatch, 4 copy */
+    unsigned int width, height, rt_count, draws, hash, depth;
+    VkFormat rt0_format, dsv_format;
+};
+
+#define VKD3D_TIMING_QUERIES 4096
+
+struct vkd3d_timing_stat
+{
+    struct vkd3d_timing_label key;
+    uint64_t ns, count, draws;
+};
+
+static int gpu_timing_enabled = -1;
+static struct vkd3d_mutex gpu_timing_mutex = VKD3D_MUTEX_INITIALIZER;
+static struct vkd3d_timing_stat gpu_timing_stats[1024];
+static unsigned int gpu_timing_stat_count;
+static uint64_t gpu_timing_total_ns, gpu_timing_dropped;
+static time_t gpu_timing_last_print;
+
+static bool vkd3d_gpu_timing_enabled(void)
+{
+    if (gpu_timing_enabled < 0)
+    {
+        const char *env = getenv("VKD3D_BARRIQUE_GPU_TIMING");
+        gpu_timing_enabled = env ? atoi(env) : 0;
+    }
+    return gpu_timing_enabled;
+}
+
+static int vkd3d_timing_stat_compare(const void *a, const void *b)
+{
+    const struct vkd3d_timing_stat *x = a, *y = b;
+    return x->ns < y->ns ? 1 : x->ns > y->ns ? -1 : 0;
+}
+
+static void vkd3d_gpu_timing_print_locked(void)
+{
+    struct vkd3d_timing_stat *sorted;
+    time_t now = time(NULL);
+    unsigned int i, secs;
+
+    if (!gpu_timing_last_print)
+        gpu_timing_last_print = now;
+    if (now - gpu_timing_last_print < 5)
+        return;
+    secs = now - gpu_timing_last_print;
+    gpu_timing_last_print = now;
+
+    if ((sorted = vkd3d_malloc(gpu_timing_stat_count * sizeof(*sorted))))
+    {
+        memcpy(sorted, gpu_timing_stats, gpu_timing_stat_count * sizeof(*sorted));
+        qsort(sorted, gpu_timing_stat_count, sizeof(*sorted), vkd3d_timing_stat_compare);
+        ERR("gpu timing: %.1f ms GPU per s over %u s, %u keys, %"PRIu64" dropped intervals.\n",
+                gpu_timing_total_ns / 1e6 / secs, secs, gpu_timing_stat_count, gpu_timing_dropped);
+        for (i = 0; i < gpu_timing_stat_count && i < 30; ++i)
+        {
+            const struct vkd3d_timing_stat *st = &sorted[i];
+            if (st->key.kind == 3 || st->key.kind == 4)
+                ERR("  %5.1f%% %7.2f ms/s n %6"PRIu64"/s %s %08x groups %ux%ux%u\n",
+                        100.0 * st->ns / max(gpu_timing_total_ns, 1), st->ns / 1e6 / secs, st->count / secs,
+                        st->key.kind == 3 ? "dispatch" : "copy line", st->key.hash,
+                        st->key.width, st->key.height, st->key.depth);
+            else
+                ERR("  %5.1f%% %7.2f ms/s n %6"PRIu64"/s draws %6"PRIu64"/s %s %ux%u rt %u fmt %d ds %d\n",
+                        100.0 * st->ns / max(gpu_timing_total_ns, 1), st->ns / 1e6 / secs,
+                        st->count / secs, st->draws / secs, st->key.kind ? "compute/copy" : "pass",
+                        st->key.width, st->key.height, st->key.rt_count, st->key.rt0_format, st->key.dsv_format);
+        }
+        vkd3d_free(sorted);
+    }
+    memset(gpu_timing_stats, 0, sizeof(gpu_timing_stats));
+    gpu_timing_stat_count = 0;
+    gpu_timing_total_ns = gpu_timing_dropped = 0;
+}
+
+/* Called once the GPU is done with the allocator's work. */
+static void d3d12_command_allocator_harvest_timing(struct d3d12_command_allocator *allocator)
+{
+    const struct vkd3d_vk_device_procs *vk_procs = &allocator->device->vk_procs;
+    double period = allocator->device->vk_info.device_limits.timestampPeriod;
+    uint64_t (*results)[2];
+    unsigned int i, j, count = allocator->timing_count;
+
+    allocator->timing_count = 0;
+    if (!count || !(results = vkd3d_calloc(count, sizeof(*results))))
+        return;
+    if (VK_CALL(vkGetQueryPoolResults(allocator->device->vk_device, allocator->timing_pool, 0, count,
+            count * sizeof(*results), results, sizeof(*results),
+            VK_QUERY_RESULT_64_BIT | VK_QUERY_RESULT_WITH_AVAILABILITY_BIT)) < 0)
+    {
+        vkd3d_free(results);
+        return;
+    }
+
+    vkd3d_mutex_lock(&gpu_timing_mutex);
+    for (i = 1; i < count; ++i)
+    {
+        const struct vkd3d_timing_label *label = &allocator->timing_labels[i];
+        uint64_t ns;
+
+        if (label->kind == 2)
+            continue;
+        if (!results[i][1] || !results[i - 1][1] || results[i][0] < results[i - 1][0])
+        {
+            ++gpu_timing_dropped;
+            continue;
+        }
+        ns = (results[i][0] - results[i - 1][0]) * period;
+        for (j = 0; j < gpu_timing_stat_count; ++j)
+        {
+            const struct vkd3d_timing_label *k = &gpu_timing_stats[j].key;
+            if (k->kind == label->kind && k->width == label->width && k->height == label->height
+                    && k->rt_count == label->rt_count && k->rt0_format == label->rt0_format
+                    && k->dsv_format == label->dsv_format && k->hash == label->hash && k->depth == label->depth)
+                break;
+        }
+        if (j == gpu_timing_stat_count)
+        {
+            if (j == ARRAY_SIZE(gpu_timing_stats))
+                continue;
+            gpu_timing_stats[j].key = *label;
+            ++gpu_timing_stat_count;
+        }
+        gpu_timing_stats[j].ns += ns;
+        gpu_timing_stats[j].count++;
+        gpu_timing_stats[j].draws += label->draws;
+        gpu_timing_total_ns += ns;
+    }
+    vkd3d_gpu_timing_print_locked();
+    vkd3d_mutex_unlock(&gpu_timing_mutex);
+    vkd3d_free(results);
+}
+
+static void d3d12_command_list_write_timestamp(struct d3d12_command_list *list, unsigned int kind)
+{
+    struct d3d12_command_allocator *allocator = list->allocator;
+    const struct vkd3d_vk_device_procs *vk_procs = &list->device->vk_procs;
+    struct vkd3d_timing_label *label;
+    VkQueryPoolCreateInfo pool_info;
+
+    if (!vkd3d_gpu_timing_enabled() || !allocator)
+        return;
+    if (!allocator->timing_pool)
+    {
+        pool_info.sType = VK_STRUCTURE_TYPE_QUERY_POOL_CREATE_INFO;
+        pool_info.pNext = NULL;
+        pool_info.flags = 0;
+        pool_info.queryType = VK_QUERY_TYPE_TIMESTAMP;
+        pool_info.queryCount = VKD3D_TIMING_QUERIES;
+        pool_info.pipelineStatistics = 0;
+        if (VK_CALL(vkCreateQueryPool(list->device->vk_device, &pool_info, NULL, &allocator->timing_pool)) < 0
+                || !(allocator->timing_labels = vkd3d_calloc(VKD3D_TIMING_QUERIES, sizeof(*label))))
+        {
+            gpu_timing_enabled = 0;
+            return;
+        }
+    }
+    if (allocator->timing_count >= VKD3D_TIMING_QUERIES)
+        return;
+
+    label = &allocator->timing_labels[allocator->timing_count];
+    memset(label, 0, sizeof(*label));
+    label->kind = allocator->timing_count == list->timing_first ? 2 : kind;
+    if (kind == 0)
+    {
+        label->width = list->fb_width;
+        label->height = list->fb_height;
+        label->rt_count = list->state && d3d12_pipeline_state_is_graphics(list->state)
+                ? list->state->u.graphics.rt_count : 0;
+        label->rt0_format = label->rt_count && list->rtv_resources[0] ? list->rtv_resources[0]->format->vk_format : 0;
+        label->dsv_format = list->dsv ? list->dsv_format : 0;
+        label->draws = list->timing_draws;
+    }
+    else
+    {
+        label->draws = list->timing_other;
+    }
+    list->timing_draws = list->timing_other = 0;
+    VK_CALL(vkCmdWriteTimestamp(list->vk_command_buffer, VK_PIPELINE_STAGE_BOTTOM_OF_PIPE_BIT,
+            allocator->timing_pool, allocator->timing_count++));
+}
+
+/* VKD3D_BARRIQUE_GPU_TIMING=2: time each dispatch and copy. The barrier ends
+ * MoltenVK's Metal encoder, so that the timestamp is taken right after it. */
+static void d3d12_command_list_time_op(struct d3d12_command_list *list, unsigned int kind,
+        unsigned int hash, unsigned int x, unsigned int y, unsigned int z)
+{
+    const struct vkd3d_vk_device_procs *vk_procs = &list->device->vk_procs;
+    struct d3d12_command_allocator *allocator = list->allocator;
+    struct vkd3d_timing_label *label;
+    VkMemoryBarrier vk_barrier;
+    unsigned int count;
+
+    if (gpu_timing_enabled < 2 || !allocator)
+        return;
+    count = allocator->timing_count;
+    d3d12_command_list_write_timestamp(list, kind);
+    if (allocator->timing_count == count)
+        return;
+    label = &allocator->timing_labels[count];
+    if (label->kind == kind)
+    {
+        label->hash = kind == 3 && list->state ? list->state->barrique_hash : hash;
+        label->width = x;
+        label->height = y;
+        label->depth = z;
+    }
+    vk_barrier.sType = VK_STRUCTURE_TYPE_MEMORY_BARRIER;
+    vk_barrier.pNext = NULL;
+    vk_barrier.srcAccessMask = VK_ACCESS_MEMORY_WRITE_BIT;
+    vk_barrier.dstAccessMask = VK_ACCESS_MEMORY_READ_BIT | VK_ACCESS_MEMORY_WRITE_BIT;
+    VK_CALL(vkCmdPipelineBarrier(list->vk_command_buffer, VK_PIPELINE_STAGE_ALL_COMMANDS_BIT,
+            VK_PIPELINE_STAGE_ALL_COMMANDS_BIT, 0, 1, &vk_barrier, 0, NULL, 0, NULL));
+}
+
+static void d3d12_command_list_close_timing(struct d3d12_command_list *list)
+{
+    struct d3d12_command_allocator *allocator = list->allocator;
+    const struct vkd3d_vk_device_procs *vk_procs = &list->device->vk_procs;
+    VkCommandBuffer vk_init_buffer;
+
+    if (!allocator || !allocator->timing_pool)
+        return;
+    if (list->timing_other)
+        d3d12_command_list_write_timestamp(list, 1);
+    if (allocator->timing_count > list->timing_first
+            && (vk_init_buffer = d3d12_command_list_get_init_command_buffer(list)))
+        VK_CALL(vkCmdResetQueryPool(vk_init_buffer, allocator->timing_pool,
+                list->timing_first, allocator->timing_count - list->timing_first));
+}
