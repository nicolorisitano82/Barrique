+
+/*
+ * Barrique: a minimal DirectComposition, enough for Chromium's Edge flavour
+ * (WebView2, msedge), which presents its software output as a DXGI composition
+ * swapchain on the root visual of a target made for its window
+ * (components/viz/service/display_embedder/software_output_device_win_swapchain.cc).
+ *
+ * No compositing is done here. Wine's dxgi gives a composition swapchain a hidden
+ * window of its own and records it in the swapchain's private data
+ * (WINE_DXGI_COMPOSITION_HWND); at Commit, the window of the content of a target's
+ * root visual becomes a child of the target's window, covering its client area,
+ * so presenting the swapchain draws into the target window. Transforms, clips,
+ * effects, nested visuals and DirectComposition surfaces are accepted and ignored,
+ * or not implemented.
+ */
+
 #include <stdarg.h>
 
+#define COBJMACROS
+#include "initguid.h"
 #include "windef.h"
 #include "winbase.h"
+#include "winuser.h"
 #include "objidl.h"
 #include "dxgi.h"
+#include "dcomp.h"
 #include "wine/debug.h"
+#include "wine/list.h"
 
 WINE_DEFAULT_DEBUG_CHANNEL(dcomp);
 
-HRESULT WINAPI DCompositionCreateDevice(IDXGIDevice *dxgi_device, REFIID iid, void **device)
+/* the same GUID as in dlls/dxgi/factory.c */
+static const GUID WINE_DXGI_COMPOSITION_HWND =
+    {0xb5d2c3a1, 0x7a4e, 0x4b8f, {0x9c, 0x21, 0x5e, 0x7d, 0x0a, 0x3f, 0x6b, 0x11}};
+
+struct composition_visual
+{
+    IDCompositionVisual2 IDCompositionVisual2_iface;
+    LONG refcount;
+    IUnknown *content;
+};
+
+struct composition_device;
+
+struct composition_target
+{
+    IDCompositionTarget IDCompositionTarget_iface;
+    LONG refcount;
+    struct composition_device *device;
+    struct list entry;
+    HWND hwnd;
+    struct composition_visual *root;
+    HWND shown;  /* content window last placed in hwnd */
+};
+
+struct composition_device
+{
+    IDCompositionDevice IDCompositionDevice_iface;
+    LONG refcount;
+    CRITICAL_SECTION cs;
+    struct list targets;
+};
+
+/* visual */
+
+static inline struct composition_visual *impl_from_IDCompositionVisual2(IDCompositionVisual2 *iface)
+{
+    return CONTAINING_RECORD(iface, struct composition_visual, IDCompositionVisual2_iface);
+}
+
+static HRESULT STDMETHODCALLTYPE visual_QueryInterface(IDCompositionVisual2 *iface, REFIID iid, void **out)
+{
+    TRACE("iface %p, iid %s, out %p.\n", iface, debugstr_guid(iid), out);
+
+    if (IsEqualGUID(iid, &IID_IDCompositionVisual2) || IsEqualGUID(iid, &IID_IDCompositionVisual)
+            || IsEqualGUID(iid, &IID_IUnknown))
+    {
+        IDCompositionVisual2_AddRef(*out = iface);
+        return S_OK;
+    }
+    WARN("%s not implemented.\n", debugstr_guid(iid));
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG STDMETHODCALLTYPE visual_AddRef(IDCompositionVisual2 *iface)
+{
+    struct composition_visual *visual = impl_from_IDCompositionVisual2(iface);
+    return InterlockedIncrement(&visual->refcount);
+}
+
+static ULONG STDMETHODCALLTYPE visual_Release(IDCompositionVisual2 *iface)
+{
+    struct composition_visual *visual = impl_from_IDCompositionVisual2(iface);
+    ULONG refcount = InterlockedDecrement(&visual->refcount);
+
+    if (!refcount)
+    {
+        if (visual->content) IUnknown_Release(visual->content);
+        free(visual);
+    }
+    return refcount;
+}
+
+static HRESULT STDMETHODCALLTYPE visual_SetOffsetXAnimation(IDCompositionVisual2 *iface, IDCompositionAnimation *animation)
+{
+    FIXME("iface %p, animation %p, ignored.\n", iface, animation);
+    return S_OK;
+}
+
+static HRESULT STDMETHODCALLTYPE visual_SetOffsetX(IDCompositionVisual2 *iface, float offset_x)
+{
+    TRACE("iface %p, offset_x %f, ignored.\n", iface, offset_x);
+    return S_OK;
+}
+
+static HRESULT STDMETHODCALLTYPE visual_SetOffsetYAnimation(IDCompositionVisual2 *iface, IDCompositionAnimation *animation)
+{
+    FIXME("iface %p, animation %p, ignored.\n", iface, animation);
+    return S_OK;
+}
+
+static HRESULT STDMETHODCALLTYPE visual_SetOffsetY(IDCompositionVisual2 *iface, float offset_y)
+{
+    TRACE("iface %p, offset_y %f, ignored.\n", iface, offset_y);
+    return S_OK;
+}
+
+static HRESULT STDMETHODCALLTYPE visual_SetTransformObject(IDCompositionVisual2 *iface, IDCompositionTransform *transform)
+{
+    FIXME("iface %p, transform %p, ignored.\n", iface, transform);
+    return S_OK;
+}
